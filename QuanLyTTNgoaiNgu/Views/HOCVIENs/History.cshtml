@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Lịch sử đăng ký của học viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h2 {
            font-size: 26px;
            margin-bottom: 25px;
            color: #1d3557;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        }

        th, td {
            padding: 12px 16px;
            text-align: center;
        }

        thead {
            background-color: #1d3557;
            color: white;
        }

        tbody tr:nth-child(even) {
            background-color: #f1f1f1;
        }

        tbody tr:hover {
            background-color: #e0f0ff;
        }

        td {
            font-size: 15px;
            color: #333;
        }

        .btn-back {
            display: inline-block;
            margin-top: 30px;
            padding: 10px 20px;
            background-color: #6c757d;
            color: white;
            text-decoration: none;
            font-weight: 600;
            border-radius: 6px;
            transition: background 0.3s;
        }

            .btn-back:hover {
                background-color: #5a6268;
            }
    </style>
}

<h2>@ViewData["Title"] – @Model.DANGKYMOI?.HoTen</h2>

<table>
    <thead>
        <tr>
            <th>Lớp học</th>
            <th>Ngày đăng ký</th>
            <th>Học phí (VND)</th>
            <th>Trạng thái nộp</th>
            <th>Ngày nộp</th>
            <th>Điểm</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ph in Model.PHIEUDANGKies)
        {
            <tr>
                <td>@ph.LOPHOC?.TenLopHoc</td>
                <td>@ph.NgayDangKy?.ToString("dd/MM/yyyy")</td>
                <td>@ph.LOPHOC?.KHOAHOC?.MucHocPhi.ToString("N0")</td>
                <td>@(ph.HOCPHI?.TrangThai == true ? "Đã nộp" : "Chưa nộp")</td>
                <td>@(ph.HOCPHI?.NgayNop?.ToString("dd/MM/yyyy") ?? "-")</td>
                <td>@(ph.KETQUAHOCTAP != null ? ph.KETQUAHOCTAP.Diem.ToString("0.0") : "-")</td>
            </tr>
        }
    </tbody>
</table>

<!-- Nút Quay lại -->
<a  asp-action="Index" class="btn-back">← Quay lại</a>
