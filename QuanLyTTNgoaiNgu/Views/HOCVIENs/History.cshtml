@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Lịch sử học viên";
}

<h2>@ViewData["Title"] – @Model.DANGKYMOI?.HoTen</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Lớp</th>
            <th>Ngày đăng ký</th>
            <th>Điểm</th>
            <th>Học phí</th>
            <th>Trạng thái nộp</th>
            <th>Ngày nộp</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.PHIEUDANGKies)
        {
            <tr>
                <td>@p.LOPHOC?.TenLopHoc</td>
                <td>@p.NgayDangKy?.ToString("dd/MM/yyyy")</td>
                <td>
                    @(p.KETQUAHOCTAP != null
                            ? p.KETQUAHOCTAP.Diem.ToString("0.0")
                            : "-")
                </td>
                <td>
                    @(p.HOCPHI != null
                            ? p.LOPHOC.KHOAHOC.MucHocPhi.ToString("N0") + " VND"
                            : "-")
                </td>
                <td>
                    @(p.HOCPHI?.TrangThai == true ? "Đã nộp" : "Chưa nộp")
                </td>
                <td>
                    @(p.HOCPHI?.NgayNop?.ToString("dd/MM/yyyy") ?? "-")
                </td>
            </tr>
        }
    </tbody>
</table>
