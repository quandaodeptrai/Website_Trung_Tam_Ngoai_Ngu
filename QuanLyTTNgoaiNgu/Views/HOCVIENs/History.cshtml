@model QuanLyTTNgoaiNgu.Models.HOCVIEN

@{
    ViewData["Title"] = "Lịch sử học tập";
}

<h1>@ViewData["Title"] của @Model.DANGKYMOI?.HoTen</h1>

@if (Model.PHIEUDANGKies == null || !Model.PHIEUDANGKies.Any())
{
        <p>Chưa có lịch sử đăng ký hoặc kết quả học tập.</p>
}
else
{
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Lớp học</th>
                    <th>Ngày đăng ký</th>
                    <th>Điểm</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var phieu in Model.PHIEUDANGKies)
            {
                    <tr>
                        <td>@(phieu.LOPHOC?.TenLopHoc ?? "—")</td>
                        <td>
                        @* Dùng DisplayFor để áp dụng DisplayFormat từ model *@
                        @Html.DisplayFor(_ => phieu.NgayDangKy)
                        </td>
                        <td>
                        @(phieu.KETQUAHOCTAP != null
                                ? phieu.KETQUAHOCTAP.Diem.ToString()
                                : "Chưa có")
                        </td>
                    </tr>
            }
            </tbody>
        </table>
}

<p>
    <a asp-action="Index" class="btn btn-secondary">Quay về danh sách</a>
    <a asp-action="AssignClass" asp-route-id="@Model.MaHocVien" class="btn btn-primary">Phân lớp</a>
</p>
