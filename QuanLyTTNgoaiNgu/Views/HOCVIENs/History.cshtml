@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Lịch sử đăng ký của học viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h2 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #1d3557;
            text-align: center;
        }

        .card {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(204,0,0,0.15);
            max-width: 1000px;
            margin: 0 auto 20px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px 16px;
            text-align: center;
        }

        thead {
            background-color: #cc0000; /* đỏ nổi bật */
            color: white;
        }

        tbody tr:nth-child(even) {
            background-color: #fdf0f0; /* đỏ nhạt */
        }

        tbody tr:hover {
            background-color: #ffe6e6;
        }

        td {
            font-size: 15px;
            color: #333;
        }

        .btn-back {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 28px;
            background-color: #6c757d; /* xám */
            color: white;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            box-shadow: 0 5px 12px rgba(108,117,125,0.3);
            transition: 0.3s;
        }

            .btn-back:hover {
                background-color: #5a6268;
                transform: translateY(-2px);
            }

        @@media (max-width: 480px) {
            .card {
                padding: 20px;
            }

            .btn-back {
                width: 100%;
                margin-bottom: 10px;
            }
        }
    </style>
}

<h2>@ViewData["Title"] – @Model.DANGKYMOI?.HoTen</h2>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>Lớp học</th>
                <th>Ngày đăng ký</th>
                <th>Học phí (VND)</th>
                <th>Trạng thái nộp</th>
                <th>Ngày nộp</th>
                <th>Điểm</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ph in Model.PHIEUDANGKies)
            {
                <tr>
                    <td>@ph.LOPHOC?.TenLopHoc</td>
                    <td>@ph.NgayDangKy?.ToString("dd/MM/yyyy")</td>
                    <td>@ph.LOPHOC?.KHOAHOC?.MucHocPhi.ToString("N0")</td>
                    <td>@(ph.HOCPHI?.TrangThai == true ? "Đã nộp" : "Chưa nộp")</td>
                    <td>@(ph.HOCPHI?.NgayNop?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>@(ph.KETQUAHOCTAP != null ? ph.KETQUAHOCTAP.Diem.ToString("0.0") : "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn-back">← Quay lại</a>