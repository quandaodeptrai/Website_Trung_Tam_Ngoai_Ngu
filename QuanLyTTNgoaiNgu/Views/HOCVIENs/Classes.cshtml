@model IEnumerable<QuanLyTTNgoaiNgu.Models.ClassInfoViewModel>

@{
    ViewData["Title"] = "Danh sách Lớp học";
    var courseId = (int)ViewBag.CourseId;
    Layout = "_LayoutHocVien";
}

@section Styles {
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            background: url('/images/anh.jpg') no-repeat center center fixed;
            background-size: cover;
            position: relative;
        }

            body::before {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(255, 235, 238, 0.5); /* mờ, tông hồng/đỏ nhạt */
                z-index: 0;
            }

        .main-container {
            position: relative;
            z-index: 1;
            max-width: 1000px;
            margin: 40px auto;
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #b71c1c; /* đỏ đậm */
            font-size: 30px;
            font-weight: bold;
        }

        .table-container {
            background: #ffffffcc; /* mờ nhẹ để thấy background */
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 15px;
        }

            .table th,
            .table td {
                padding: 12px 15px;
                text-align: center;
                border-bottom: 1px solid #dee2e6;
            }

            .table thead {
                background-color: #b71c1c; /* đỏ đậm */
                color: #fff;
                font-weight: 600;
            }

        .table-striped tbody tr:nth-child(odd) {
            background-color: #ffe5e5; /* tông hồng nhạt */
        }

        ul {
            padding-left: 20px;
            margin: 0;
            text-align: left;
        }

        .alert {
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }

        .btn {
            padding: 8px 18px;
            font-size: 14px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-success {
            background-color: #b71c1c;
            color: #fff;
        }

            .btn-success:hover {
                background-color: #7f0000;
            }

        .text-muted {
            color: #6c757d;
        }

        .back-button-container {
            text-align: left;
            margin-top: 25px;
        }

        .btn-back {
            display: inline-block;
            padding: 10px 20px;
            background: linear-gradient(135deg, #f44336, #d32f2f);
            color: #fff;
            border: none;
            border-radius: 30px;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                background: linear-gradient(135deg, #d32f2f, #b71c1c);
                transform: translateY(-2px);
            }
    </style>
}

<div class="main-container">
    <div class="table-container">
        <h2>@ViewData["Title"]</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Lớp</th>
                    <th>SL tối đa</th>
                    <th>SL hiện tại</th>
                    <th>Ngày bắt đầu</th>
                    <th>Thời khóa biểu</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td>@l.TenLopHoc</td>
                        <td>@l.SLHocVienToiDa</td>
                        <td>@l.SLHocVienHienTai</td>
                        <td>@l.NgayBatDau.ToString("dd/MM/yyyy")</td>
                        <td>
                            <ul>
                                @foreach (var tkb in l.Schedules)
                                {
                                    <li>@tkb.CaHoc — @tkb.NgayHoc?.ToString("dd/MM/yyyy")</li>
                                }
                            </ul>
                        </td>
                        <td>
                            @if (l.CanRegister)
                            {
                                <form asp-action="RegisterClass" method="post">
                                    <input type="hidden" name="classId" value="@l.MaLopHoc" />
                                    <button type="submit" class="btn btn-success">Đăng ký</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Không thể đăng ký</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="back-button-container">
            <a asp-action="Courses" class="btn-back">
                ← Quay lại
            </a>
        </div>
    </div>
</div>