@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Xóa Học viên";
}
<h1>@ViewData["Title"]</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Thông tin Học viên</h5>
        <dl class="row">
            <dt class="col-sm-3">Mã Học viên</dt>
            <dd class="col-sm-9">@Model.MaHocVien</dd>

            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@Model.DANGKYMOI?.HoTen</dd>

            <dt class="col-sm-3">Ngày sinh</dt>
            <dd class="col-sm-9">@(Model.DANGKYMOI?.NgaySinh?.ToString("dd/MM/yyyy") ?? "")</dd>

            <dt class="col-sm-3">Điện thoại</dt>
            <dd class="col-sm-9">@Model.DANGKYMOI?.SoDienThoai</dd>

            <dt class="col-sm-3">Địa chỉ</dt>
            <dd class="col-sm-9">@Model.DANGKYMOI?.DiaChi</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.DANGKYMOI?.Email</dd>

            <dt class="col-sm-3">Mã Tài khoản</dt>
            <dd class="col-sm-9">@Model.MaTaiKhoan</dd>
        </dl>
    </div>
</div>

<h4 class="text-danger">Bạn có chắc chắn muốn xóa Học viên này?</h4>
<form asp-action="Delete">
    <input type="hidden" asp-for="MaHocVien" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
