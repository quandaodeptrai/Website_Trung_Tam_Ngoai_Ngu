@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Xóa Học viên";
    Layout = "_LayoutAdmin";
}


@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #1d3557;
            text-align: center;
        }

        .card {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(204,0,0,0.15);
            max-width: 800px;
            margin: 0 auto 20px;
        }

        dl.row {
            margin: 0;
        }

        dt {
            font-weight: 600;
            color: #660000;
        }

        dd {
            margin-bottom: 15px;
            color: #333;
        }

        .warning-text {
            font-size: 18px;
            color: #b30000;
            font-weight: bold;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-actions {
            text-align: center;
            margin-top: 20px;
        }

        .btn {
            display: inline-block;
            padding: 12px 28px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s;
            font-size: 16px;
        }

        .btn-danger {
            background-color: #cc0000;
            color: white;
            border: none;
            box-shadow: 0 5px 12px rgba(204,0,0,0.3);
        }

            .btn-danger:hover {
                background-color: #990000;
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            border: none;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
                transform: translateY(-2px);
            }

        @@media (max-width: 480px) {
            .card {
                padding: 20px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }

            .form-actions {
                display: flex;
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <h4>Thông tin Học viên</h4>
    <dl class="row">
        <dt class="col-sm-4">Mã Học viên</dt>
        <dd class="col-sm-8">@Model.MaHocVien</dd>

        <dt class="col-sm-4">Họ tên</dt>
        <dd class="col-sm-8">@Model.DANGKYMOI?.HoTen</dd>

        <dt class="col-sm-4">Ngày sinh</dt>
        <dd class="col-sm-8">@(Model.DANGKYMOI?.NgaySinh?.ToString("dd/MM/yyyy") ?? "")</dd>

        <dt class="col-sm-4">Điện thoại</dt>
        <dd class="col-sm-8">@Model.DANGKYMOI?.SoDienThoai</dd>

        <dt class="col-sm-4">Địa chỉ</dt>
        <dd class="col-sm-8">@Model.DANGKYMOI?.DiaChi</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.DANGKYMOI?.Email</dd>

        <dt class="col-sm-4">Mã Tài khoản</dt>
        <dd class="col-sm-8">@Model.MaTaiKhoan</dd>
    </dl>
</div>

<p class="warning-text">⚠️ Bạn có chắc chắn muốn xóa học viên này?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MaHocVien" />
    <div class="form-actions">
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>