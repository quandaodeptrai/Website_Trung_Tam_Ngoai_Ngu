@model QuanLyTTNgoaiNgu.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_LayoutHocVien"; 
}

@section Styles {
    <style>
        .change-password-container {
            max-width: 500px;
            margin: 40px auto;
            padding: 30px;
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.08);
        }

            .change-password-container h2 {
                text-align: center;
                color: #1d3557;
                margin-bottom: 25px;
            }

        .form-label {
            font-weight: bold;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            font-size: 15px;
            border: 1px solid #ccc;
            border-radius: 8px;
            margin-top: 5px;
        }

            .form-control:focus {
                border-color: #1d3557;
                outline: none;
                box-shadow: 0 0 5px rgba(29, 53, 87, 0.2);
            }

        .text-danger {
            color: #e63946;
            font-size: 14px;
        }

        .btn-group {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
        }

        .btn {
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-primary {
            background-color: #1d3557;
            color: #fff;
        }

            .btn-primary:hover {
                background-color: #0b2442;
            }

        .btn-secondary {
            background-color: #adb5bd;
            color: #fff;
        }

            .btn-secondary:hover {
                background-color: #889096;
            }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 6px;
            text-align: center;
        }
    </style>
}

<div class="change-password-container">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert-success">@TempData["Message"]</div>
    }

    <form asp-action="ChangePassword" method="post">
        <div class="mb-3">
            <label asp-for="OldPassword" class="form-label">Mật khẩu hiện tại</label>
            <input asp-for="OldPassword" class="form-control" />
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
            <input asp-for="NewPassword" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
            <a asp-action="ChangePassword" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
