@model QuanLyTTNgoaiNgu.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_LayoutHocVien";
}

@section Styles {
    <style>
        body {
            background-color: #ffebee; /* nền nhẹ đỏ hồng */
        }

        .change-password-container {
            max-width: 500px;
            margin: 50px auto;
            padding: 35px 30px;
            background: linear-gradient(135deg, #f8bbd0, #f44336);
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
            color: #fff;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            position: relative;
            overflow: hidden;
        }

            .change-password-container h2 {
                text-align: center;
                margin-bottom: 25px;
                font-size: 28px;
                font-weight: 700;
                text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
            }

        .form-label {
            font-weight: 600;
            color: #fff;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            font-size: 15px;
            border: 1px solid #fff;
            border-radius: 8px;
            margin-top: 5px;
            background-color: rgba(255,255,255,0.9);
            color: #333;
        }

            .form-control:focus {
                border-color: #b71c1c;
                outline: none;
                box-shadow: 0 0 8px rgba(183,28,28,0.4);
            }

        .text-danger {
            color: #ffebee;
            font-size: 14px;
        }

        .btn-group {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            gap: 10px;
        }

        .btn {
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background-color: #b71c1c;
            color: #fff;
        }

            .btn-primary:hover {
                background-color: #7f0000;
            }

        .btn-secondary {
            background-color: rgba(255,255,255,0.6);
            color: #b71c1c;
        }

            .btn-secondary:hover {
                background-color: rgba(255,255,255,0.9);
                color: #7f0000;
            }

        .alert-success {
            background-color: #ffcdd2;
            color: #b71c1c;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
        }

        /* Hiệu ứng bóng tròn trang trí */
        .change-password-container::before,
        .change-password-container::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            opacity: 0.15;
        }

        .change-password-container::before {
            width: 150px;
            height: 150px;
            background-color: #fff;
            top: -50px;
            right: -50px;
        }

        .change-password-container::after {
            width: 200px;
            height: 200px;
            background-color: #fff;
            bottom: -80px;
            left: -80px;
        }

        /* Responsive */
        @@media (max-width: 600px) {
            .change-password-container {
                padding: 25px 20px;
            }

                .change-password-container h2 {
                    font-size: 24px;
                }

            .btn-group {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="change-password-container">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert-success">@TempData["Message"]</div>
    }

    <form asp-action="ChangePassword" method="post">
        <div class="mb-3">
            <label asp-for="OldPassword" class="form-label">Mật khẩu hiện tại</label>
            <input asp-for="OldPassword" class="form-control" />
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
            <input asp-for="NewPassword" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
            <a asp-action="ChangePassword" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}