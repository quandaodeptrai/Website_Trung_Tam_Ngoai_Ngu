@model IEnumerable<QuanLyTTNgoaiNgu.Models.THONGBAO>
@{
    ViewData["Title"] = "Thông báo của bạn";
    Layout = "_LayoutHocVien";
}

@section Styles {
    <style>
        body {
            background-color: #ffebee; /* nền hồng nhạt */
        }

        h2 {
            font-size: 28px;
            color: #b71c1c; /* đỏ đậm */
            text-align: center;
            margin-bottom: 30px;
            font-family: "Times New Roman", Times, serif;
            font-weight: bold;
        }

        .notification-container {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
            max-width: 1000px;
            margin: 0 auto 40px auto;
        }

        .notification-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

            .notification-table thead {
                background: linear-gradient(90deg, #f44336, #e53935);
                color: white;
                font-weight: 600;
            }

            .notification-table th, .notification-table td {
                padding: 14px 16px;
                border: 1px solid #eee;
                text-align: left;
                font-size: 15px;
            }

            .notification-table tbody tr:nth-child(even) {
                background-color: #ffe0e0;
            }

            .notification-table tbody tr:hover {
                background-color: #ffcccc;
                transform: scale(1.01);
                transition: all 0.2s ease;
            }

        .alert-info {
            background-color: #ffcccb;
            color: #b71c1c;
            padding: 15px;
            border-radius: 8px;
            max-width: 600px;
            margin: 20px auto;
            text-align: center;
            font-weight: bold;
        }

        .btn-back {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 20px;
            border-radius: 6px;
            background-color: transparent;
            color: #b71c1c;
            border: 2px solid #b71c1c;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                background-color: #b71c1c;
                color: #fff;
            }

        .btn-wrapper {
            text-align: center;
        }
    </style>
}

<div class="notification-container">
    <h2>@ViewData["Title"]</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Bạn chưa có thông báo nào.</div>
    }
    else
    {
        <table class="notification-table">
            <thead>
                <tr>
                    <th>Ngày</th>
                    <th>Tiêu đề</th>
                    <th>Nội dung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tb in Model)
                {
                    <tr>
                        <td>@tb.NgayThongBao?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@tb.TieuDe</td>
                        <td>@tb.NoiDung</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
