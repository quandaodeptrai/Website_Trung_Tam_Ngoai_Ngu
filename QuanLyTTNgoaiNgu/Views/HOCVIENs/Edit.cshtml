@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Sửa Học viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #1d3557;
            text-align: center;
        }

        form {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            max-width: 700px;
            margin: 0 auto;
            box-shadow: 0 10px 25px rgba(204,0,0,0.15);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-bottom: 6px;
            color: #660000;
        }

        input[type="text"],
        input[type="date"],
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            transition: 0.3s;
        }

            input[type="text"]:focus,
            input[type="date"]:focus {
                border-color: #cc0000;
                box-shadow: 0 0 5px rgba(204,0,0,0.3);
                outline: none;
            }

        .text-danger {
            color: #e63946;
            font-size: 14px;
        }

        .btn {
            display: inline-block;
            padding: 12px 28px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            transition: 0.3s;
            margin-right: 10px;
        }

        .btn-success {
            background-color: #cc0000;
            color: white;
            border: none;
            box-shadow: 0 5px 12px rgba(204,0,0,0.3);
        }

            .btn-success:hover {
                background-color: #990000;
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            border: none;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
                transform: translateY(-2px);
            }

        @@media (max-width: 480px) {
            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }
    </style>
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaHocVien" />
    <input type="hidden" asp-for="MaDangKy" />
    <input type="hidden" asp-for="DANGKYMOI.MaQuanTriVien" />

    <div class="form-group">
        <label asp-for="DANGKYMOI.HoTen"></label>
        @Html.EditorFor(m => m.DANGKYMOI.HoTen, new { htmlAttributes = new { @class = "form-control" } })
        <span asp-validation-for="DANGKYMOI.HoTen" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DANGKYMOI.NgaySinh"></label>@Html.EditorFor(m => m.DANGKYMOI.NgaySinh, new { htmlAttributes = new { @class = "form-control", type = "date" } })
        <span asp-validation-for="DANGKYMOI.NgaySinh" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DANGKYMOI.SoDienThoai"></label>
        @Html.EditorFor(m => m.DANGKYMOI.SoDienThoai, new { htmlAttributes = new { @class = "form-control" } })
        <span asp-validation-for="DANGKYMOI.SoDienThoai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DANGKYMOI.DiaChi"></label>
        @Html.EditorFor(m => m.DANGKYMOI.DiaChi, new { htmlAttributes = new { @class = "form-control" } })
        <span asp-validation-for="DANGKYMOI.DiaChi" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DANGKYMOI.Email"></label>
        @Html.EditorFor(m => m.DANGKYMOI.Email, new { htmlAttributes = new { @class = "form-control" } })
        <span asp-validation-for="DANGKYMOI.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaTaiKhoan"></label>
        <input type="text" class="form-control" value="@ViewBag.TenTaiKhoan" readonly />
        <input type="hidden" asp-for="MaTaiKhoan" />
    </div>

    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
        @@await Html.RenderPartialAsync("_ValidationScriptsPartial")
}