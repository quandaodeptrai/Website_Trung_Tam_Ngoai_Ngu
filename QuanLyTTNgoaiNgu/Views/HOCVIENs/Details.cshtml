@model QuanLyTTNgoaiNgu.Models.HOCVIEN
@{
    ViewData["Title"] = "Chi tiết Học viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #1d3557;
            text-align: center;
        }

        .card {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(204,0,0,0.15);
            max-width: 800px;
            margin: 0 auto 30px;
        }

        dl.row {
            margin: 0;
        }

        dt {
            font-weight: 600;
            color: #660000;
            width: 200px;
            float: left;
        }

        dd {
            margin: 0 0 15px 210px;
            color: #333;
        }

        .button-group {
            text-align: center;
            margin-top: 30px;
        }

        .btn {
            display: inline-block;
            padding: 12px 28px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            transition: 0.3s;
            margin: 0 10px;
        }

        .btn-primary {
            background-color: #cc0000;
            color: white;
            border: none;
            box-shadow: 0 5px 12px rgba(204,0,0,0.3);
        }

            .btn-primary:hover {
                background-color: #990000;
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            border: none;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
                transform: translateY(-2px);
            }

        @@media (max-width: 480px) {
            dt, dd {
                float: none;
                margin-left: 0;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }

            .button-group {
                display: flex;
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <dl class="row">
        <dt>Mã Học viên:</dt>
        <dd>@Model.MaHocVien</dd>

        <dt>Họ tên:</dt>
        <dd>@Model.DANGKYMOI?.HoTen</dd>

        <dt>Ngày sinh:</dt>
        <dd>@(Model.DANGKYMOI?.NgaySinh?.ToString("dd/MM/yyyy") ?? "")</dd>

        <dt>Điện thoại:</dt>
        <dd>@Model.DANGKYMOI?.SoDienThoai</dd>

        <dt>Địa chỉ:</dt>
        <dd>@Model.DANGKYMOI?.DiaChi</dd>

        <dt>Email:</dt>
        <dd>@Model.DANGKYMOI?.Email</dd>

        <dt>Mã Tài khoản:</dt>
        <dd>@Model.MaTaiKhoan</dd>
    </dl>

    <div class="button-group">
        <a asp-action="Edit" asp-route-id="@Model.MaHocVien" class="btn btn-primary">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>