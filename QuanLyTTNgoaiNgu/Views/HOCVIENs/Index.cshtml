@model IEnumerable<QuanLyTTNgoaiNgu.Models.HOCVIEN>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DANGKYMOI)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TAIKHOAN)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DANGKYMOI.DiaChi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TAIKHOAN.MatKhau)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaHocVien">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaHocVien">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaHocVien">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
