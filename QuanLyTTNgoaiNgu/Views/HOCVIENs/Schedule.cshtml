@model IEnumerable<QuanLyTTNgoaiNgu.Models.ScheduleItemViewModel>
@{
    ViewData["Title"] = "Lịch học của bạn";
    Layout = "_LayoutHocVien";

    // Ngày đang chọn
    var selectedDate = ViewContext.HttpContext.Request.Query["date"].Count > 0
        ? DateTime.Parse(ViewContext.HttpContext.Request.Query["date"])
        : DateTime.Now;

    // Tính thứ 2 đầu tuần
    DateTime StartOfWeek(DateTime dt)
    {
        int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
        return dt.AddDays(-diff).Date;
    }

    var startWeek = StartOfWeek(selectedDate);
    var endWeek = startWeek.AddDays(6);

    // Lọc lịch học theo tuần
    var filtered = Model
        .Where(s => s.NgayHoc.HasValue &&
            s.NgayHoc.Value.Date >= startWeek &&
            s.NgayHoc.Value.Date <= endWeek)
        .ToList();

    // Gom theo (Ngày, Ca)
    var grouped = filtered
        .GroupBy(s => (s.NgayHoc!.Value.Date, s.CaHoc))
        .ToDictionary(g => g.Key, g => g.ToList());

    // Ca học cố định
    var caHocList = new List<string> { "1-3", "4-6", "7-9", "10-12" };

    // Danh sách 7 ngày (Thứ 2 → Chủ nhật)
    var days = Enumerable.Range(0, 7)
                         .Select(i => startWeek.AddDays(i))
                         .ToList();
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<h2 class="title">@ViewData["Title"]</h2>

<style>
    .title {
        text-align: center;
        font-size: 30px;
        margin: 30px 0;
        color: #B30000;
        font-weight: 700;
        text-transform: uppercase;
    }

    .schedule-container {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(179,0,0,0.15);
        animation: fadeIn 0.4s ease;
    }

    .schedule-table {
        width: 100%;
        border-collapse: collapse;
    }

        .schedule-table thead {
            background: linear-gradient(90deg, #B30000, #E60000);
            color: white;
            font-size: 15px;
            text-transform: uppercase;
        }

        .schedule-table th, .schedule-table td {
            padding: 14px;
            text-align: center;
            border: 1px solid #f0f0f0;
        }

    .schedule-item {
        padding: 8px;
        background: #FFE6E6;
        border-left: 4px solid #CC0000;
        border-radius: 6px;
        font-size: 14px;
        margin-bottom: 6px;
        text-align: left;
        box-shadow: 0 2px 6px rgba(204,0,0,0.1);
    }

    .week-controls {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .btn-week {
        padding: 8px 18px;
        border-radius: 6px;
        border: none;
        background: #CC0000;
        color: white;
        cursor: pointer;
        font-weight: bold;
        transition: 0.25s;
    }

        .btn-week:hover {
            background: #990000;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="week-controls">
    <button class="btn-week" onclick="changeWeek(-7)">← Tuần trước</button>

    <input type="date" id="datePicker"
           value="@selectedDate.ToString("yyyy-MM-dd")"
           class="form-control" style="width: 180px;" />

    <button class="btn-week" onclick="changeWeek(7)">Tuần sau →</button>
</div>

<div class="schedule-container">
    <div class="table-responsive">
        <table class="schedule-table">
            <thead>
                <tr>
                    <th>Ca học</th>
                    @foreach (var d in days)
                    {
                        <th>@Html.Raw(d.ToString("dddd<br>dd/MM"))</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var ca in caHocList)
                {
                    <tr>
                        <td><b>@ca</b></td>

                        @foreach (var d in days)
                        {
                            var key = (d.Date, ca);
                            grouped.TryGetValue(key, out var list);

                            <td>
                                @if (list != null)
                                {
                                    foreach (var item in list)
                                    {
                                        <div class="schedule-item">
                                            <b>@item.TenKhoaHoc</b><br />
                                            Lớp: @item.TenLopHoc
                                        </div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function changeWeek(days) {
        let picker = document.getElementById("datePicker");
        let date = new Date(picker.value);
        date.setDate(date.getDate() + days);

        picker.value = date.toISOString().split('T')[0];
        window.location.href = `?date=${picker.value}`;
    }

    document.getElementById("datePicker").addEventListener("change", function () {
        window.location.href = `?date=${this.value}`;
    });
</script>