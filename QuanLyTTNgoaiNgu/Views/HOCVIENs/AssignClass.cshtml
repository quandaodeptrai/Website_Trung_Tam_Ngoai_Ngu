@model QuanLyTTNgoaiNgu.Models.HOCVIEN

@{
    ViewData["Title"] = "Phân lớp cho học viên";
}

<h1>@ViewData["Title"]</h1>

<div>
    <strong>Học viên:</strong>
    @Model.DANGKYMOI?.HoTen
</div>

<form asp-action="AssignClass" method="post">
    <input type="hidden" asp-for="MaHocVien" />

    <div class="form-group">
        <label for="selectedLopHoc">Chọn lớp</label>
        <select id="selectedLopHoc"
                name="selectedLopHoc"
                class="form-control"
                asp-items="ViewBag.AvailableClasses">
            <option value="">-- Chọn một lớp --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Phân lớp</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
