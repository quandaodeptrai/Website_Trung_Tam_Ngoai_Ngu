@model IEnumerable<QuanLyTTNgoaiNgu.Models.ResultItemViewModel>
@{
    ViewData["Title"] = "Xem kết quả thi";
    Layout = "_LayoutHocVien";
}

<h2>@ViewData["Title"]</h2>

<style>
    body {
        background-color: #ffebee; /* nền hồng nhạt */
    }

    h2 {
        text-align: center;
        margin-bottom: 30px;
        font-size: 28px;
        color: #b71c1c; /* đỏ đậm */
        font-family: "Times New Roman", Times, serif;
        font-weight: bold;
    }

    table {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto 40px;
        border-collapse: collapse;
        background-color: #fff;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        border-radius: 12px;
        overflow: hidden;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    thead {
        background: linear-gradient(90deg, #f44336, #e53935);
        color: #fff;
        font-weight: 600;
        font-size: 16px;
    }

    th, td {
        padding: 14px 16px;
        text-align: center;
        font-size: 15px;
        border-bottom: 1px solid #eee;
    }

    tbody tr:nth-child(even) {
        background-color: #ffebee;
    }

    tbody tr:hover {
        background-color: #ffe0e0;
        transform: scale(1.01);
        transition: all 0.2s ease;
    }

    .text-danger {
        color: #c62828;
        font-weight: bold;
    }

    .btn {
        display: inline-block;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        color: #fff;
        background-color: #e53935;
        border: none;
        border-radius: 6px;
        transition: background-color 0.3s ease, transform 0.1s ease;
        cursor: pointer;
    }

        .btn:hover {
            background-color: #b71c1c;
            transform: scale(1.05);
        }
</style>

<table>
    <thead>
        <tr>
            <th>Khóa học</th>
            <th>Lớp học</th>
            <th>Điểm</th>
            <th>Xếp loại</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.TenKhoaHoc</td>
                <td>@r.TenLopHoc</td>
                <td>@(r.CanView? r.Diem.ToString("0.0") : "-")</td>
                <td>@(r.CanView? r.XepLoai: "-")</td>
                <td>
                    @if (!r.CanView)
                    {
                        <span class="text-danger">Vui lòng thanh toán công nợ trước</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

