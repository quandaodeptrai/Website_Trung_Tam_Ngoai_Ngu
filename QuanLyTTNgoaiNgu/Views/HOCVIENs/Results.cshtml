@model IEnumerable<QuanLyTTNgoaiNgu.Models.ResultItemViewModel>
@{
    ViewData["Title"] = "Xem kết quả thi";
    Layout = "_LayoutHocVien";
}

<h2>@ViewData["Title"]</h2>
<style>
    h2 {
        text-align: center;
        margin-bottom: 30px;
        font-size: 28px;
        color: #1a237e;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        margin-top: 20px;
    }

    th, td {
        padding: 16px 20px;
        text-align: left;
        border-bottom: 1px solid #e0e0e0;
    }

    thead {
        background-color: #3949ab;
        color: white;
    }

    tr:hover {
        background-color: #f1f1f1;
    }

    .text-danger {
        color: #d32f2f;
        font-weight: 500;
    }

    .btn {
        display: inline-block;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 500;
        text-align: center;
        text-decoration: none;
        color: #ffffff;
        background-color: #3949ab;
        border: none;
        border-radius: 6px;
        transition: background-color 0.3s ease;
        cursor: pointer;
    }

        .btn:hover {
            background-color: #303f9f;
        }
</style>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Khóa học</th>
            <th>Lớp học</th>
            <th>Điểm</th>
            <th>Xếp loại</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.TenKhoaHoc</td>
                <td>@r.TenLopHoc</td>
                <td>@(r.CanView ? r.Diem.ToString("0.0") : "-")</td>
                <td>@(r.CanView ? r.XepLoai : "-")</td>
                <td>
                    @if (!r.CanView)
                    {
                            <span class="text-danger">Vui lòng thanh toán công nợ trước</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


