@model IEnumerable<QuanLyTTNgoaiNgu.Models.THONGBAO>

@{
    ViewData["Title"] = "Danh sách Thông báo";
    Layout = "_LayoutAdmin";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-bullhorn fa-xl text-danger me-2"></i>
        <h3 class="fw-bold text-danger m-0">DANH SÁCH THÔNG BÁO</h3>
    </div>

    <a asp-action="Create" class="btn-red mb-3">
        <i class="fa-solid fa-plus me-1"></i> Tạo thông báo mới
    </a>

    <!-- BẢNG -->
    <div class="table-responsive shadow-lg rounded bg-white p-3">

        <table class="table table-bordered table-hover align-middle text-center">

            <thead class="text-white" style="background: linear-gradient(90deg, #c1121f, #a4161a);">
                <tr>
                    <th>STT</th>
                    <th>Tiêu đề</th>
                    <th>Nội dung</th>
                    <th>Ngày thông báo</th>
                    <th>Phân quyền</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-muted py-4">
                            <i class="fa-solid fa-circle-info me-1"></i> Không có thông báo nào.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var tb in Model)
                    {
                        <tr>
                            <td class="fw-bold text-danger">@stt</td>

                            <td class="text-start fw-semibold">
                                <i class="fa-solid fa-bell text-danger me-1"></i>
                                @tb.TieuDe
                            </td>

                            <td class="text-start text-truncate" style="max-width: 350px;">
                                <i class="fa-regular fa-message text-secondary me-1"></i>
                                @tb.NoiDung
                            </td>

                            <td>
                                <i class="fa-regular fa-calendar-days text-danger me-1"></i>
                                @(tb.NgayThongBao.HasValue ? tb.NgayThongBao.Value.ToString("dd/MM/yyyy") : "")
                            </td>

                            <td>
                                <span class="badge px-3 py-2 rounded-pill
                                    @(tb.TaiKhoan?.VaiTro == "Admin" ? "bg-danger text-white" :
                                      tb.TaiKhoan?.VaiTro == "GiangVien" ? "bg-warning text-dark" :
                                      "bg-secondary text-white")">
                            <i class="fa-solid fa-user-shield me-1"></i>@tb.TaiKhoan?.VaiTro
                        </span>
                    </td>

                        </tr>
                                stt++;
                    }
                }
            </tbody>
        </table>

    </div>
</div>


<style>

    /* ==========================
           BUTTON STYLE (TONE ĐỎ)
           ========================== */

    .btn-red {
        background: linear-gradient(90deg, #c1121f, #e63946);
        color: #fff !important;
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 15px;
        box-shadow: 0 4px 10px rgba(255, 0, 0, .25);
        transition: all .25s ease;
        display: inline-block;
    }

        .btn-red:hover {
            background: #b30000;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(255, 0, 0, .35);
        }

    .btn-red-outline {
        background: transparent;
        border: 2px solid #c1121f;
        color: #c1121f !important;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
        transition: all .25s ease;
        display: inline-block;
    }

        .btn-red-outline:hover {
            background: #c1121f;
            color: white !important;
            transform: translateY(-2px);
        }

    .btn-gray {
        background: #6c757d;
        color: #fff !important;
        border: none;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
        transition: all .25s ease;
        display: inline-block;
    }

        .btn-gray:hover {
            background: #565e64;
            transform: translateY(-2px);
        }


    /* ==========================
           TABLE STYLE
           ========================== */

    table {
        border-collapse: collapse !important;
    }

    th, td {
        border: 1px solid #ddd !important;
        padding: 12px 14px;
        vertical-align: middle;
    }

    th {
        font-weight: 600;
        text-transform: uppercase;
    }

    tbody tr {
        transition: 0.25s;
    }

        tbody tr:hover {
            background-color: #ffe5e5 !important;
            transform: scale(1.01);
        }

    .table-responsive {
        box-shadow: 0 4px 14px rgba(255, 0, 0, 0.12);
    }

    .text-truncate {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>