@model QuanLyTTNgoaiNgu.Models.THONGBAO

@{
    ViewData["Title"] = "Chỉnh sửa Thông báo";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            color: #1d3557;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-container {
            background: #ffffff;
            padding: 40px;
            border-radius: 16px;
            max-width: 700px;
            margin: auto;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                font-weight: 600;
                color: #1d3557;
                display: block;
                margin-bottom: 8px;
            }

        .form-control {
            width: 100%;
            border-radius: 8px;
            padding: 10px 12px;
            border: 1px solid #ccc;
            transition: border-color 0.3s ease;
        }

            .form-control:focus {
                border-color: #457b9d;
                outline: none;
                box-shadow: 0 0 0 2px rgba(69, 123, 157, 0.2);
            }

        .text-danger {
            color: #e63946;
            font-size: 14px;
        }

        .form-actions {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
        }

        .btn-custom {
            background-color: #1d3557;
            color: white;
            padding: 10px 24px;
            font-size: 16px;
            border-radius: 8px;
            border: none;
            transition: background-color 0.3s ease;
            text-decoration: none;
        }

            .btn-custom:hover {
                background-color: #16395e;
            }

        .btn-back {
            background-color: #adb5bd;
        }

            .btn-back:hover {
                background-color: #6c757d;
            }
    </style>
}

<h1>@ViewData["Title"]</h1>

<div class="form-container">
    <form asp-action="Edit">
        <input type="hidden" asp-for="MaThongBao" />

        <div class="form-group">
            <label asp-for="TieuDe"></label>
            <input asp-for="TieuDe" class="form-control" />
            <span asp-validation-for="TieuDe" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NoiDung"></label>
            <textarea asp-for="NoiDung" class="form-control" rows="5"></textarea>
            <span asp-validation-for="NoiDung" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NgayThongBao"></label>
            <input asp-for="NgayThongBao" class="form-control" type="date" />
            <span asp-validation-for="NgayThongBao" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-custom">Lưu thay đổi</button>
            <a asp-action="Index" class="btn-custom btn-back">Quay lại</a>
        </div>
    </form>
</div>
