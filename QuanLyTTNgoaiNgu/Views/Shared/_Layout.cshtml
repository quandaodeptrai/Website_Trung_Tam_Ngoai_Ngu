<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyTTNgoaiNgu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyTTNgoaiNgu.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">QuanLyTTNgoaiNgu</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="HOCVIENs" asp-action="Index">Học viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="GIANGVIENs" asp-action="Index">Giảng viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="KHOAHOCs" asp-action="Index">Khóa học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="LOPHOCs" asp-action="Index">Lớp học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="TAIKHOANs" asp-action="Index">Tài khoản</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="PHIEUDANGKies" asp-action="Index">Đăng ký lớp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="HOCPHIs" asp-action="Index">Học phí</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="KETQUAHOCTAPs" asp-action="Index">Kết quả học tập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="THOIKHOABIEUx" asp-action="Index">Thời khóa biểu</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="DANGKYMOIs" asp-action="Index">Đăng ký mới</a>
                        </li>
                        

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - QuanLyTTNgoaiNgu - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
