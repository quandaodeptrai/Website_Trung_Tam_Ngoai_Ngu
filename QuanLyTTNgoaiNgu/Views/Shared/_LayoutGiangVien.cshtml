@{
    Layout = null;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Giảng viên | Trung tâm Ngoại ngữ 5AE</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/Home.css" />
    @RenderSection("Styles", required: false)

</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2 class="sidebar-title">Giảng viên</h2>
            <p class="sidebar-user">Xin chào, @fullName!</p>

            <nav class="nav-links">
                <a asp-controller="GIANGVIENs" asp-action="MyClasses" class="btn btn-primary">Xem lớp của tôi</a>
                <a asp-controller="GIANGVIENs" asp-action="ScheduleAll"  class="btn btn-secondary">Lịch dạy</a>
                <a asp-controller="GIANGVIENs" asp-action="Notifications" class="btn btn-info">Xem thông báo </a>

                <a asp-controller="GIANGVIENs"
                   asp-action="EnterScores"
                   asp-route-classId="@ViewBag.MaLopHoc"
                   class="btn btn-sm btn-primary ms-1">
                    Nhập điểm
                </a>

                <a asp-controller="Account" asp-action="Logout" class="logout"
                   onclick="return confirm('Bạn chắc chắn muốn đăng xuất?')">Đăng xuất</a>
            </nav>
        </aside>

        <!-- Nội dung chính -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

