@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@if (!HttpContextAccessor.HttpContext.User.Identity.IsAuthenticated)
{
    <script>
        window.location.href = "/Account/Login";
    </script>
}

@{

    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
}
@section Scripts {
    <script>
        window.addEventListener("pageshow", function (event) {
            if (event.persisted || (window.performance && performance.navigation.type === 2)) {
                // Nếu quay lại bằng nút back -> reload lại trang (và sẽ bị redirect do đã đăng xuất)
                location.reload();
            }
        });
    </script>

}



<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Giảng viên | Trung tâm Ngoại ngữ 5AE</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/Home.css" />
    @RenderSection("Styles", required: false)
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" />


</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2 class="sidebar-title">Giảng viên</h2>
            <p class="sidebar-user">Xin chào, @fullName!</p>

            <nav class="nav-links">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                }

                <a asp-controller="GIANGVIENs" asp-action="MyClasses"
                   class="@(currentController == "GIANGVIENs" && currentAction == "MyClasses" ? "active" : "")">
                    Lớp đang dạy
                </a>

                <a asp-controller="GIANGVIENs" asp-action="ScheduleAll"
                   class="@(currentController == "GIANGVIENs" && currentAction == "ScheduleAll" ? "active" : "")">
                    Lịch dạy
                </a>

                <a asp-controller="GIANGVIENs" asp-action="Notifications"
                   class="@(currentController == "GIANGVIENs" && currentAction == "Notifications" ? "active" : "")">
                    Xem thông báo
                </a>


                <a asp-controller="Account" asp-action="Logout" class="logout"
                   onclick="return confirm('Bạn chắc chắn muốn đăng xuất?')">Đăng xuất</a>

            </nav>
        </aside>

        <!-- Nội dung chính -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

