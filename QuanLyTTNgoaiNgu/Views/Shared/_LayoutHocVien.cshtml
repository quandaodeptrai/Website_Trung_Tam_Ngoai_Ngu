﻿@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@if (!HttpContextAccessor.HttpContext.User.Identity.IsAuthenticated)
{
    <script>
        window.location.href = "/Account/Login";
    </script>
}

@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
}

@section Scripts {
    <script>
        window.addEventListener("pageshow", function (event) {
            if (event.persisted || (window.performance && performance.navigation.type === 2)) {
                // Nếu quay lại bằng nút back -> reload lại trang (và sẽ bị redirect do đã đăng xuất)
                location.reload();
            }
        });
    </script>
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Học viên | Trung tâm Ngoại ngữ 5AE</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/Home.css" />
    @RenderSection("Styles", required: false)
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" />

    <style>
        :root {
            --primary-red: #c62828;
            --primary-red-dark: #8e0000;
            --background-light: #fafafa;
            --text-light: #f5f5f5;
            --text-muted: #ddd;
            --hover-bg: rgba(198, 40, 40, 0.15);
            --active-bg: #ef5350;
            --logout-bg: #b71c1c;
            --logout-bg-hover: #d32f2f;
            --font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            margin: 0;
            font-family: var(--font-family);
            background-color: var(--background-light);
            color: #333;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
            background-color: var(--background-light);
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, var(--primary-red-dark), var(--primary-red));
            color: var(--text-light);
            display: flex;
            flex-direction: column;
            padding: 25px 20px;
            box-shadow: 3px 0 15px rgba(0,0,0,0.2);
        }

        .sidebar-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            text-align: center;
            user-select: none;
        }

        .sidebar-user {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 30px;
            text-align: center;
            user-select: none;
        }

        /* Navigation links */
        .nav-links {
            display: flex;
            flex-direction: column;
            gap: 14px;
            flex-grow: 1;
        }

            .nav-links a {
                padding: 12px 16px;
                border-radius: 8px;
                font-weight: 500;
                transition: background-color 0.25s ease, transform 0.15s ease;
                display: flex;
                align-items: center;
                color: var(--text-light);
                text-decoration: none;
            }

                .nav-links a i {
                    min-width: 20px;
                    text-align: center;
                    margin-right: 10px;
                    transition: color 0.25s ease;
                }

                .nav-links a:hover {
                    background-color: var(--hover-bg);
                    transform: translateX(4px);
                }

                    .nav-links a:hover i {
                        color: var(--primary-red-dark);
                    }

                .nav-links a.active {
                    background-color: var(--active-bg);
                    font-weight: 700;
                    box-shadow: inset 0 0 10px rgba(0,0,0,0.2);
                    transform: none;
                }

        .logout {
            background-color: var(--logout-bg);
            color: white;
            font-weight: 700;
            text-align: center;
            padding: 12px 16px;
            border-radius: 8px;
            user-select: none;
            transition: background-color 0.3s ease;
            cursor: pointer;
            margin-top: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logout i {
                margin-right: 8px;
            }

            .logout:hover {
                background-color: var(--logout-bg-hover);
            }

        /* Main content */
        .main-content {
            flex-grow: 1;
            background-color: white;
            padding: 40px 35px;
            border-radius: 12px 0 0 12px;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.05);
            overflow-y: auto;
        }

        /* Responsive for smaller screens */
        @@media (max-width: 768px) {
            .dashboard-container {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: space-around;
                padding: 15px 10px;
                box-shadow: none;
                border-radius: 0;
            }

            .sidebar-title, .sidebar-user {
                flex-basis: 100%;
                text-align: center;
                margin-bottom: 12px;
            }

            .nav-links {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: center;
                gap: 10px;
                flex-grow: 0;
            }

                .nav-links a, .logout {
                    flex-grow: 1;
                    text-align: center;
                    padding: 10px 12px;
                    font-size: 14px;
                    border-radius: 6px;
                }

            .logout {
                margin-top: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2 class="sidebar-title">Học viên</h2>
            <p class="sidebar-user">Xin chào, @fullName!</p>

            <nav class="nav-links">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                }

                <a asp-controller="HOCVIENs" asp-action="ChangePassword"
                   class="@(currentController == "HOCVIENs" && currentAction == "ChangePassword" ? "active" : "")">
                    <i class="fas fa-key"></i> Đổi mật khẩu
                </a>

                <a asp-controller="HOCVIENs" asp-action="Courses"
                   class="@(currentController == "HOCVIENs" && currentAction == "Courses" ? "active" : "")">
                    <i class="fas fa-book-open"></i> Xem khóa học
                </a>

                <a asp-controller="HOCVIENs" asp-action="Schedule"
                   class="@(currentController == "HOCVIENs" && currentAction == "Schedule" ? "active" : "")">
                    <i class="fas fa-calendar-alt"></i> Xem lịch học
                </a>

                <a asp-controller="HOCVIENs" asp-action="Debt"
                   class="@(currentController == "HOCVIENs" && currentAction == "Debt" ? "active" : "")">
                    <i class="fas fa-wallet"></i> Kiểm tra công nợ
                </a>

                <a asp-controller="HOCVIENs" asp-action="Results"
                   class="@(currentController == "HOCVIENs" && currentAction == "Results" ? "active" : "")">
                    <i class="fas fa-chart-line"></i> Xem kết quả thi
                </a>

                <a asp-controller="HOCVIENs" asp-action="Notifications"
                   class="@(currentController == "HOCVIENs" && currentAction == "Notifications" ? "active" : "")">
                    <i class="fas fa-bell"></i> Xem thông báo
                </a>

                <a asp-controller="HOCVIENs" asp-action="ChangeInfor"
                   class="@(currentController == "HOCVIENs" && currentAction == "ChangeInfor" ? "active" : "")">
                    <i class="fas fa-user-edit"></i> Đổi thông tin cá nhân
                </a>

                <a asp-controller="Account" asp-action="Logout" class="logout"
                   onclick="return confirm('Bạn chắc chắn muốn đăng xuất?')">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>

            </nav>
        </aside>

        <!-- Nội dung chính -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>