@{
    Layout = null;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Học viên | Trung tâm Ngoại ngữ 5AE</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/Home.css" />
    @RenderSection("Styles", required: false)

</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2 class="sidebar-title">Học viên</h2>
            <p class="sidebar-user">Xin chào, @fullName!</p>

            <nav class="nav-links">
                <a asp-controller="HOCVIENs" asp-action="ChangePassword"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "ChangePassword" ? "active" : "")">
                    Đổi mật khẩu
                </a>

                <a asp-controller="HOCVIENs" asp-action="Courses"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "Courses" ? "active" : "")">
                    Xem khóa học
                </a>

                <a asp-controller="HOCVIENs" asp-action="Schedule"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "Schedule" ? "active" : "")">
                    Xem lịch học
                </a>

                <a asp-controller="HOCVIENs" asp-action="Debt"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "Debt" ? "active" : "")">
                    Kiểm tra công nợ
                </a>

                <a asp-controller="HOCVIENs" asp-action="Results"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "Results" ? "active" : "")">
                    Xem kết quả thi
                </a>

                <a asp-controller="HOCVIENs" asp-action="Notifications"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "Notifications" ? "active" : "")">
                    Xem thông báo
                </a>

                <a asp-controller="HOCVIENs" asp-action="ChangeInfor"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" && ViewContext.RouteData.Values["Action"]?.ToString() == "ChangeInfor" ? "active" : "")">
                    Đổi thông tin cá nhân
                </a>

       
                <a asp-controller="Account" asp-action="Logout" class="logout"
                   onclick="return confirm('Bạn chắc chắn muốn đăng xuất?')">Đăng xuất</a>
            </nav>
        </aside>

        <!-- Nội dung chính -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
