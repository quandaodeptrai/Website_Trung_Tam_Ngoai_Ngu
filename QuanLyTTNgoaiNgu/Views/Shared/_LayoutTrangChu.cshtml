@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trung tâm Ngoại ngữ 5AE</title>
    <link href="~/css/home_index.css" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f8f9fa, #c6e2ff);
            min-height: 100vh;
        }

        header {
            background-color: #1d3557;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .navbar-brand {
            font-size: 30px;
            font-weight: bold;
            text-decoration: none;
            color: white;
        }

        .navbar-right {
            display: flex;
            gap: 20px;
        }

            .navbar-right a, .navbar-text {
                font-size: 22px;
                font-weight: bold;
                color: white;
                text-decoration: none;
                padding: 10px 20px;
                border-radius: 10px;
                transition: 0.3s;
            }

                .navbar-right a:hover {
                    background-color: #ffd166;
                    color: #1d3557;
                }

        .container {
            padding: 40px 20px;
        }

        footer {
            background-color: #1d3557;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 40px;
        }
    </style>
    @RenderSection("Styles", required: false)

</head>
<body>

    <header>
 
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">TRUNG TÂM NGOẠI NGỮ 5AE</a>

        <div class="navbar-right">
 
                <a href="/Account/Login">Đăng nhập</a>
                <a href="/DANGKYMOIs/Create">Đăng ký</a>

        </div>
    </header>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        &copy; 2025 - Trung tâm Ngoại ngữ 5AE. All rights reserved.
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
