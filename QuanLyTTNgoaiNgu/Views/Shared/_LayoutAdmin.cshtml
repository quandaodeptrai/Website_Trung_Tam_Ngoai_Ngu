﻿@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@if (!HttpContextAccessor.HttpContext.User.Identity.IsAuthenticated)
{
    <script>
        window.location.href = "/Account/Login";
    </script>
}

@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
}

@section Scripts {
    <script>
        window.addEventListener("pageshow", function (event) {
            if (event.persisted || (window.performance && performance.navigation.type === 2)) {
                location.reload();
            }
        });
    </script>
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Quản trị | Trung tâm Ngoại ngữ 5AE</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @RenderSection("Styles", required: false)
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" />

    <!-- Font Awesome (icon đẹp chuyên nghiệp) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        /* ==== RESET ==== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            background: #f8f9fa;
            color: #333;
        }

        /* ==== DASHBOARD CONTAINER ==== */
        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* ==== SIDEBAR ==== */
        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #b30000, #7a0000);
            color: #fff;
            padding: 25px 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 3px 0 10px rgba(0,0,0,0.15);
        }

        .sidebar-title {
            font-size: 22px;
            font-weight: 700;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 20px;
            letter-spacing: 1px;
        }

        .sidebar-user {
            font-size: 15px;
            margin-bottom: 30px;
            text-align: center;
            color: #ffdddd;
        }

        .nav-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .nav-links a {
                text-decoration: none;
                color: #fff;
                padding: 10px 14px;
                border-radius: 8px;
                transition: all 0.2s ease-in-out;
                font-size: 15px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .nav-links a i {
                    width: 20px;
                    text-align: center;
                }

                .nav-links a:hover {
                    background: rgba(255,255,255,0.15);
                    transform: translateX(4px);
                }

                .nav-links a.active {
                    background: #fff;
                    color: #b30000;
                    font-weight: 600;
                    box-shadow: 0 0 10px rgba(255,255,255,0.3);
                }

        .logout {
            margin-top: 30px;
            color: #ffd6d6 !important;
            border-top: 1px solid rgba(255,255,255,0.2);
            padding-top: 15px;
            font-weight: 600;
        }

            .logout:hover {
                color: #fff !important;
                background: rgba(255, 80, 80, 0.3);
            }

        /* ==== MAIN CONTENT ==== */
        .main-content {
            flex: 1;
            padding: 30px 40px;
            background: #fff;
            box-shadow: inset 0 0 8px rgba(0,0,0,0.05);
            border-radius: 10px 0 0 10px;
        }

            .main-content h1 {
                color: #b30000;
                font-size: 26px;
                margin-bottom: 25px;
                border-bottom: 2px solid #b30000;
                display: inline-block;
                padding-bottom: 5px;
            }

        /* ==== RESPONSIVE ==== */
        @@media (max-width: 900px) {
            .dashboard-container {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                flex-direction: row;
                overflow-x: auto;
                justify-content: start;
            }

            .nav-links {
                flex-direction: row;
                flex-wrap: nowrap;
            }

            .main-content {
                border-radius: 0;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div>
                <h2 class="sidebar-title"><i class="fa-solid fa-user-shield"></i> Admin</h2>
                <p class="sidebar-user">Xin chào, @fullName!</p>

                <nav class="nav-links">
                    <a asp-controller="DANGKYMOIs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "DANGKYMOIs" ? "active" : "")">
                        <i class="fa-solid fa-file-pen"></i> Quản lý Phiếu đăng ký
                    </a>
                    <a asp-controller="HOCVIENs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCVIENs" ? "active" : "")">
                        <i class="fa-solid fa-user-graduate"></i> Quản lý Học viên
                    </a>
                    <a asp-controller="GIANGVIENs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "GIANGVIENs" ? "active" : "")">
                        <i class="fa-solid fa-chalkboard-user"></i> Quản lý Giảng viên
                    </a>
                    <a asp-controller="KHOAHOCs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KHOAHOCs" ? "active" : "")">
                        <i class="fa-solid fa-book"></i> Quản lý Khóa học
                    </a>
                    <a asp-controller="LOPHOCs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "LOPHOCs" ? "active" : "")">
                        <i class="fa-solid fa-people-group"></i> Quản lý Lớp học
                    </a>
                    <a asp-controller="KETQUAHOCTAPs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KETQUAHOCTAPs" ? "active" : "")">
                        <i class="fa-solid fa-star"></i> Kết quả học tập
                    </a>
                    <a asp-controller="HOCPHIs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HOCPHIs" ? "active" : "")">
                        <i class="fa-solid fa-money-bill-wave"></i> Quản lý Học phí
                    </a>
                    <a asp-controller="TAIKHOANs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "TAIKHOANs" ? "active" : "")">
                        <i class="fa-solid fa-user-gear"></i> Quản lý Tài khoản
                    </a>
                    <a asp-controller="THONGBAOs" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "THONGBAOs" ? "active" : "")">
                        <i class="fa-solid fa-bullhorn"></i> Quản lý Thông báo
                    </a>
                    <a asp-controller="THOIKHOABIEUx" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "THOIKHOABIEUx" ? "active" : "")">
                        <i class="fa-solid fa-calendar-days"></i> Thời khóa biểu
                    </a>
                    <a asp-controller="Reports" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">
                        <i class="fa-solid fa-chart-line"></i> Báo cáo – Thống kê
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="logout"
                       onclick="return confirm('Bạn chắc chắn muốn đăng xuất?')">
                        <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Nội dung chính -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>