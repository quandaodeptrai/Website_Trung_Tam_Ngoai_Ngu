@{
    Layout = "_LayoutGiangVien";
    ViewData["Title"] = "Giảng viên Dashboard";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
}
<link rel="stylesheet" href="~/css/Home.css" />
<div class="welcome-card">
    <h1>Trang quản lý của Giảng viên</h1>
    <p>Chào mừng bạn <strong>@fullName</strong> đến với hệ thống quản lý Trung tâm Ngoại ngữ 5AE.</p>
    <p>Vui lòng chọn chức năng từ thanh menu bên trái để tiếp tục công việc quản lý.</p>
</div>