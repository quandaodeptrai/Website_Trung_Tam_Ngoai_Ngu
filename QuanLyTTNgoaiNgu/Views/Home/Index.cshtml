@model IEnumerable<QuanLyTTNgoaiNgu.Models.KHOAHOC>

@{
    ViewData["Title"] = "Trang chủ";
}

<h1>Danh sách khóa học</h1>

<ul>
    @foreach (var khoahoc in Model)
    {
        <li>
            <strong>@khoahoc.TenKhoaHoc</strong><br />
            @khoahoc.MoTa<br />
            Học phí: @String.Format("{0:N0}", khoahoc.MucHocPhi) VNĐ
        </li>
    }
</ul>
