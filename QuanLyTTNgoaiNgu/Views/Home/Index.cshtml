@model IEnumerable<QuanLyTTNgoaiNgu.Models.KHOAHOC>

@{
    Layout = "_LayoutTrangChu";
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" />
}

<!-- Carousel -->
<div class="carousel">
    <img src="@((ViewBag.CarouselImages as List<string>)?[0] ?? "/images/anh_trung_tam.jpg")"
         alt="Slide chính"
         style="width: 100%; max-height: 450px; object-fit: cover; border-radius: 10px; margin-bottom: 30px;">

</div>

<!-- Khóa học nổi bật -->
<section class="courses-section">
    <h2 class="section-title">Khóa học nổi bật</h2>
    <div class="course-grid">
        @foreach (var item in ViewBag.FeaturedCourses)
        {
            <div class="course-card">
                <img src="@item.Image" alt="@item.TenKhoaHoc">
                <div class="course-content">
                    <h3>@item.TenKhoaHoc</h3>
                    <p class="description">@item.MoTa</p>
                </div>
            </div>
        }
    </div>
</section>
