@model IEnumerable<QuanLyTTNgoaiNgu.Models.THOIKHOABIEU>
@{
    ViewData["Title"] = "Thời khóa biểu";
    Layout = "_LayoutGiangVien";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #f4f6f9;
        padding: 30px;
    }

    h2 {
        text-align: center;
        font-size: 28px;
        color: #c0392b;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .alert {
        background-color: #fdecea;
        border-left: 6px solid #e74c3c;
        padding: 15px 20px;
        color: #922b21;
        font-size: 16px;
        max-width: 900px;
        margin: 20px auto;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .table {
        width: 100%;
        max-width: 900px;
        margin: 0 auto 40px auto;
        border-collapse: collapse;
        background-color: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border-radius: 10px;
        overflow: hidden;
    }

        .table thead {
            background-color: #e74c3c;
            color: white;
        }

        .table th, .table td {
            padding: 12px 16px;
            text-align: center;
            border-bottom: 1px solid #f2f2f2;
            font-size: 15px;
        }

        .table tbody tr:hover {
            background-color: #fff5f5;
        }

    .btn-back {
        display: inline-block;
        background-color: #e74c3c;
        color: white;
        text-decoration: none;
        padding: 10px 22px;
        font-size: 15px;
        border-radius: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

        .btn-back:hover {
            background-color: #c0392b;
            transform: translateY(-1px);
        }

    .btn-container {
        text-align: center;
        margin-top: 25px;
    }
</style>

<h2>Thời khóa biểu: @ViewBag.ClassName</h2>

@if (!Model.Any())
{
    <div class="alert">
        Chưa có thời khóa biểu cho lớp này.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ngày học</th>
                <th>Ca học</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.NgayHoc?.ToString("dd/MM/yyyy")</td>
                    <td>@t.CaHoc</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="btn-container">
    <a asp-action="MyClasses" class="btn-back">← Quay lại lớp của tôi</a>
</div>