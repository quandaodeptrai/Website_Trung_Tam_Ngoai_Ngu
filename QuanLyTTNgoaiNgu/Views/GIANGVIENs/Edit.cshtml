@model QuanLyTTNgoaiNgu.Models.GIANGVIEN

@{
    ViewData["Title"] = "Chỉnh sửa Giảng viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            background: #fff5f5;
        }

        h1 {
            font-size: 30px;
            margin-bottom: 25px;
            font-weight: 700;
            color: #b60000;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            h1 i {
                color: #d10000;
            }

        form {
            max-width: 680px;
            background: #ffffff;
            padding: 35px;
            border-radius: 15px;
            border: 1px solid #ffcccc;
            box-shadow: 0 8px 20px rgba(255, 0, 0, 0.15);
        }

        .form-group {
            margin-bottom: 22px;
        }

        label {
            font-weight: bold;
            color: #8b0000;
            margin-bottom: 6px;
            display: block;
        }

        .input-icon {
            position: relative;
        }

            .input-icon i {
                position: absolute;
                top: 50%;
                left: 12px;
                transform: translateY(-50%);
                color: #b70000;
                font-size: 16px;
            }

            .input-icon input,
            .input-icon select {
                width: 100%;
                padding: 12px 12px 12px 38px;
                border: 1px solid #e6b3b3;
                border-radius: 6px;
                background: #fffafa;
                font-size: 15px;
                transition: 0.25s;
            }

                .input-icon input:focus,
                .input-icon select:focus {
                    border-color: #cc0000;
                    box-shadow: 0 0 6px rgba(204, 0, 0, 0.45);
                    outline: none;
                }

        .text-danger {
            font-size: 14px;
            color: #d90429;
            margin-top: 4px;
            display: block;
        }

        /* Nút gradient đỏ */
        .btn-primary {
            background: linear-gradient(45deg, #ff0000, #b30000);
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(255, 0, 0, 0.35);
            transition: 0.3s;
        }

            .btn-primary:hover {
                background: linear-gradient(45deg, #cc0000, #990000);
                box-shadow: 0 5px 16px rgba(255, 0, 0, 0.45);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            padding: 12px 22px;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            transition: 0.25s;
        }

            .btn-secondary:hover {
                background-color: #565e64;
            }

        .btn-container {
            margin-top: 30px;
            display: flex;
            gap: 12px;
        }

        .btn i {
            margin-right: 6px;
        }
    </style>
}

<h1><i class="fa-solid fa-user-pen"></i> @ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaGiangVien" />

    <div class="form-group">
        <label asp-for="HoTen"></label>
        <div class="input-icon">
            <i class="fa-solid fa-user"></i>
            <input asp-for="HoTen" />
        </div>
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ChuyenMon"></label>
        <div class="input-icon">
            <i class="fa-solid fa-book"></i>
            <input asp-for="ChuyenMon" />
        </div>
        <span asp-validation-for="ChuyenMon" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <div class="input-icon">
            <i class="fa-solid fa-envelope"></i>
            <input asp-for="Email" />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SoDienThoai"></label>
        <div class="input-icon">
            <i class="fa-solid fa-phone"></i>
            <input asp-for="SoDienThoai" />
        </div>
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaTaiKhoan"></label>
        <div class="input-icon">
            <i class="fa-solid fa-id-card"></i>
            <select asp-for="MaTaiKhoan" asp-items="ViewBag.MaTaiKhoan"></select>
        </div>
        <span asp-validation-for="MaTaiKhoan" class="text-danger"></span>
    </div>

    <div class="btn-container">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Lưu
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}