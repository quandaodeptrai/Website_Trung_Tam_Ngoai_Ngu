@model List<QuanLyTTNgoaiNgu.Models.ScoreEntryViewModel>

@{
    Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
    ViewData["Title"] = "Nhập điểm – " + (ViewBag.TenLop ?? "Lớp học");
}

@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f4f6f9;
            padding: 30px;
        }

        h2 {
            text-align: center;
            color: #2c3e50;
            font-size: 28px;
            margin-bottom: 30px;
        }

        .alert {
            padding: 15px;
            background-color: #ecf0f1;
            border-left: 6px solid #3498db;
            margin-bottom: 20px;
            font-size: 16px;
            color: #2c3e50;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
            background-color: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 10px;
            overflow: hidden;
        }

        th, td {
            padding: 12px 16px;
            text-align: center;
            border-bottom: 1px solid #eee;
            font-size: 15px;
        }

        thead {
            background-color: #3498db;
            color: white;
        }

        tbody tr:hover {
            background-color: #f0f8ff;
        }

        .btn {
            padding: 8px 16px;
            background: #3498db;
            color: white;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s ease;
            display: inline-block;
        }

            .btn:hover {
                background: #2980b9;
            }

        .btn-sm {
            font-size: 13px;
            padding: 6px 12px;
        }
    </style>
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Success"] != null)
{
    <div class="alert">
        @TempData["Success"]
    </div>
}

<form asp-action="EnterScores" asp-route-classId="@ViewBag.ClassId" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert" })

    <table>
        <thead>
            <tr>
                <th>Họ tên học viên</th>
                <th>Điểm (0–10)</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        @Model[i].TenHocVien
                        <input type="hidden" asp-for="@Model[i].MaPhieu" />
                    </td>
                    <td>
                        <input asp-for="@Model[i].Diem" class="form-control" />
                        <span asp-validation-for="@Model[i].Diem" class="text-danger small"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn">Lưu điểm</button>
        <a asp-controller="GIANGVIENs" asp-action="MyClasses" class="btn btn-sm">Quay lại</a>
    </div>
</form>
