@model List<QuanLyTTNgoaiNgu.Models.ScoreEntryViewModel>

@{
    Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
    ViewData["Title"] = "Nhập điểm – " + (ViewBag.TenLop ?? "Lớp học");
}

@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f8f9fa;
            padding: 30px;
        }

        h2 {
            text-align: center;
            color: #b22222;
            font-size: 28px;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .alert {
            padding: 15px;
            background-color: #fff4f4;
            border-left: 6px solid #b22222;
            margin-bottom: 25px;
            font-size: 16px;
            color: #7b1111;
            border-radius: 6px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
            background-color: #ffffff;
            box-shadow: 0 4px 12px rgba(178, 34, 34, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }

        th, td {
            padding: 12px 16px;
            text-align: center;
            border-bottom: 1px solid #f1dede;
            font-size: 15px;
        }

        thead {
            background-color: #b22222;
            color: white;
        }

        tbody tr:hover {
            background-color: #fff5f5;
        }

        .form-control {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            text-align: center;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .form-control:focus {
                border-color: #b22222;
                box-shadow: 0 0 5px rgba(178, 34, 34, 0.3);
                outline: none;
            }

        .text-danger {
            color: #c0392b;
            font-size: 13px;
        }

        .btn {
            padding: 10px 20px;
            background: #b22222;
            color: white;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-size: 15px;
            cursor: pointer;
            transition: 0.3s ease;
            font-weight: 600;
        }

            .btn:hover {
                background: #8b0000;
                box-shadow: 0 3px 6px rgba(178, 34, 34, 0.25);
            }

        .btn-sm {
            padding: 8px 14px;
            font-size: 14px;
            background-color: #a9a9a9;
        }

            .btn-sm:hover {
                background-color: #7d7d7d;
            }

        .action-row {
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        @@media (max-width: 768px) {
            table {
                font-size: 14px;
            }

            .btn {
                width: 100%;
            }

            .action-row {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Success"] != null)
{
    <div class="alert">
        @TempData["Success"]
    </div>
}

<form asp-action="EnterScores" asp-route-classId="@ViewBag.ClassId" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert" })

    <table>
        <thead>
            <tr>
                <th>Họ tên học viên</th>
                <th>Điểm (0–10)</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        @Model[i].TenHocVien
                        <input type="hidden" asp-for="@Model[i].MaPhieu" />
                    </td>
                    <td>
                        <input asp-for="@Model[i].Diem" class="form-control" />
                        <span asp-validation-for="@Model[i].Diem" class="text-danger small"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="action-row">
        <button type="submit" class="btn">💾 Lưu điểm</button>
        <a asp-controller="GIANGVIENs" asp-action="MyClasses" class="btn btn-sm">⬅ Quay lại</a>
    </div>
</form>