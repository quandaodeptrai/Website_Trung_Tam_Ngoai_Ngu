@model PhanCongGiangVienViewModel
@{
    ViewData["Title"] = "Phân công giảng viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        .phancong-container {
            max-width: 1000px;
            margin: 50px auto;
            padding: 40px;
            background: #fff5f5; /* tone đỏ nhạt nền */
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(200,35,51,0.1);
        }

        h2, h4 {
            color: #c82333;
        }

        h2 {
            font-size: 32px;
            margin-bottom: 30px;
            text-align: center;
            font-weight: 700;
            text-shadow: 1px 1px #f8d7da;
        }

        .form-label {
            font-weight: 600;
            color: #a71d2a;
        }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 10px 14px;
            border: 1.5px solid #c82333;
            transition: all 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #a71d2a;
                box-shadow: 0 0 8px rgba(200, 35, 51, 0.2);
            }

        .btn-primary, .btn-success, .btn-danger {
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(200,35,51,0.2);
            transition: all 0.3s;
            color: #fff;
            border: none;
        }

        .btn-primary {
            background-color: #c82333;
        }

            .btn-primary:hover {
                background-color: #a71d2a;
                box-shadow: 0 6px 14px rgba(200,35,51,0.4);
            }

        .btn-success {
            background-color: #e76f51;
        }

            .btn-success:hover {
                background-color: #d65c40;
            }

        .btn-danger {
            background-color: #c82333;
        }

            .btn-danger:hover {
                background-color: #a71d2a;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            box-shadow: 0 4px 12px rgba(200,35,51,0.1);
            border-radius: 8px;
            overflow: hidden;
            margin-top: 20px;
        }

        th, td {
            padding: 14px 18px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            background-color: #c82333;
            color: white;
            font-weight: 600;
        }

        tr:hover {
            background-color: #ffe6e6;
        }

        .badge-ca {
            background-color: #e76f51;
            color: white;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 14px;
        }

        .validation-summary-errors {
            margin-bottom: 20px;
            color: #a71d2a;
        }

        .table-responsive {
            overflow-x: auto;
        }
    </style>
}


<div class="phancong-container">
    <h2>Phân công giảng viên</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <!-- FORM CHỈ CHỌN LỚP -->
    <form asp-action="ThucHienPhanCong" method="post" class="row g-4 mb-4">
        <div class="col-md-8">
            <label asp-for="MaLopHoc" class="form-label">Lớp học</label>
            <select asp-for="MaLopHoc" class="form-select" asp-items="ViewBag.LopHocList">
                <option value="">-- Chọn lớp --</option>
            </select>
            <span asp-validation-for="MaLopHoc" class="text-danger"></span>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Xem danh sách giảng viên</button>
        </div>
    </form>

    @if (Model?.DanhSachGiangVienPhuHop != null)
    {
        <div class="mb-4">
            <h4>Danh sách giảng viên phù hợp</h4>

            <p>
                <strong>Lớp:</strong>
                @(
                            (Model.MaLopHoc != 0)
                            ? ((ViewBag.LopHocList as SelectList)?.FirstOrDefault(i => Convert.ToInt32(i.Value) == Model.MaLopHoc)?.Text ?? "")
                            : ""
                            )
        </p>

            @* Show schedule selector (all schedules of the class) *@
        @if (ViewBag.Schedules != null)
            {
                var schedules = ViewBag.Schedules as List<QuanLyTTNgoaiNgu.Models.THOIKHOABIEU>;
                <div class="mb-3">
                    <label class="form-label">Chọn ngày / ca để phân công</label>
                    <select id="scheduleSelect" class="form-select filter-input" style="min-width:260px;">
                        @foreach (var s in schedules)
                        {
                            var display = s.NgayHoc?.ToString("dd/MM/yyyy") + " - " + s.CaHoc;
                            // value format: yyyy-MM-dd|CaHoc (JS sẽ parse)
                            var val = s.NgayHoc?.ToString("yyyy-MM-dd") + "|" + s.CaHoc;
                            <option value="@val">@display</option>
                        }
                    </select>
                </div>
            }

            <p>
                <strong>Ngày đã chọn:</strong> <span id="selectedDate">@Model.NgayHoc != default(DateTime) ? Model.NgayHoc.ToString("dd/MM/yyyy") : ""</span>
                &nbsp;|&nbsp;
                <strong>Ca:</strong> <span id="selectedCa">@Model.CaHoc</span>
            </p>

            <form asp-action="ThucHienPhanCong" method="post" class="row g-3">
                @* gửi ẩn ngày/ca/lop để action phân công dùng *@
                <input type="hidden" asp-for="MaLopHoc" />
                <input type="hidden" asp-for="NgayHoc" id="NgayHocHidden" />
                <input type="hidden" asp-for="CaHoc" id="CaHocHidden" />

                <div class="col-md-8">
                    <label asp-for="MaGiangVienDuocChon" class="form-label">Giảng viên</label>
                    <select asp-for="MaGiangVienDuocChon" class="form-select">
                        <option value="">-- Chọn giảng viên --</option>
                        @foreach (var gv in Model.DanhSachGiangVienPhuHop)
                        {
                            <option value="@gv.MaGiangVien">@gv.HoTen - @gv.ChuyenMon</option>
                        }
                    </select>
                    <span asp-validation-for="MaGiangVienDuocChon" class="text-danger"></span>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Phân công</button>
                </div>
            </form>
        </div>

        <script>
            (function(){
                const sel = document.getElementById('scheduleSelect');
                const dateSpan = document.getElementById('selectedDate');
                const caSpan = document.getElementById('selectedCa');
                const ngayHidden = document.getElementById('NgayHocHidden');
                const caHidden = document.getElementById('CaHocHidden');

                if (!sel) return;

                function applySelection() {
                    const v = sel.value; // "yyyy-MM-dd|Ca"
                    const parts = v.split('|');
                    const d = parts[0];
                    const ca = parts[1] || '';
                    // set hidden inputs in format bindable by model (DateTime)
                    ngayHidden.value = d;
                    caHidden.value = ca;

                    // show friendly text
                    const partsD = d.split('-');
                    if (partsD.length === 3) {
                        dateSpan.textContent = partsD[2] + '/' + partsD[1] + '/' + partsD[0];
                    } else {
                        dateSpan.textContent = d;
                    }
                    caSpan.textContent = ca;
                }

                // init
                applySelection();

                sel.addEventListener('change', applySelection);
            })();
        </script>
    }

    else if (Model?.DanhSachGiangVienPhuHop != null && !Model.DanhSachGiangVienPhuHop.Any())
    {
        <div class="alert alert-warning">Không tìm thấy giảng viên phù hợp cho ngày/ca này.</div>
    }

    <!-- Lịch đã phân công giữ nguyên phần bạn đang có -->
    <h4>Lịch đã phân công</h4>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Giảng viên</th>
                    <th>Lớp học</th>
                    <th>Ngày học</th>
                    <th>Ca học</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.LichDaPhanCong != null)
                {
                    foreach (var item in ViewBag.LichDaPhanCong as List<QuanLyTTNgoaiNgu.Models.LichPhanCongItem>)
                    {
                        <tr>
                            <td>@item.TenGiangVien</td>
                            <td>@item.TenLopHoc</td>
                            <td>@item.NgayHoc.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge-ca">@item.CaHoc</span></td>
                            <td>
                                <form asp-action="XoaLich" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa lịch này?');">
                                    <input type="hidden" name="MaLichHoc" value="@item.MaLichHoc" />
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
