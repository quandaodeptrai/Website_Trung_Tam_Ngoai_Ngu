@model QuanLyTTNgoaiNgu.Models.ApproveViewModel

@{
    ViewData["Title"] = "Duyệt đăng ký";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .approve-container {
            max-width: 900px;
            margin: 40px auto 60px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204, 0, 0, 0.2);
            padding: 40px 50px;
        }

        h2 {
            color: #b30000;
            font-weight: 700;
            margin-bottom: 30px;
            text-align: center;
            font-size: 28px;
        }

        .info-row p {
            font-size: 16px;
            color: #333;
            margin-bottom: 12px;
        }

        .form-label {
            font-weight: 600;
            color: #660000;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            font-size: 16px;
            border-radius: 8px;
            border: 1.8px solid #cc0000;
            margin-bottom: 20px;
            outline: none;
        }

            .form-control:disabled {
                background-color: #f8f9fa;
                color: #555;
            }

        .btn-approve {
            background: #cc0000;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 12px 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 5px 10px rgba(204,0,0,0.3);
        }

            .btn-approve:hover {
                background: #990000;
            }

        .btn-back {
            background: #6c757d;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 12px 20px;
            font-size: 16px;
            font-weight: 600;
            margin-left: 12px;
            text-decoration: none;
            display: inline-block;
            transition: 0.3s;
        }

            .btn-back:hover {
                background: #5a6268;
            }

        @@media (max-width: 768px) {
            .approve-container {
                padding: 30px 20px;
            }

            .btn-back {
                margin-left: 0;
                margin-top: 12px;
                display: block;
            }
        }
    </style>
}

<div class="approve-container">
    <h2>@ViewData["Title"]</h2>

    <div class="info-row">
        <p><strong>Họ tên:</strong> @Model.HoTen</p>
        <p><strong>Ngày sinh:</strong> @Model.NgaySinh?.ToString("dd/MM/yyyy")</p>
        <p><strong>ĐT:</strong> @Model.SoDienThoai</p>
        <p><strong>Địa chỉ:</strong> @Model.DiaChi</p>
        <p><strong>Email:</strong> @Model.Email</p>
    </div>

    <form asp-action="Approve" method="post">
        <input type="hidden" name="MaDangKy" value="@Model.MaDangKy" />

        <label class="form-label">Tên đăng nhập được sinh</label>
        <input class="form-control" value="@Model.GeneratedUsername" disabled />

        <button type="submit" class="btn-approve">Xác nhận duyệt</button>
        <a asp-action="Pending" class="btn-back">Quay lại</a>
    </form>
</div>