@{
    ViewData["Title"] = "Đăng ký thành công";
    Layout = "_LayoutTrangChu";
}

@section Styles {
    <style>
        .success-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
            padding: 20px;
        }

        .success-box {
            text-align: center;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
            max-width: 600px;
        }

            .success-box h2 {
                color: #2a9d8f;
                font-weight: bold;
                margin-bottom: 20px;
            }

            .success-box p {
                font-size: 18px;
                color: #333;
                margin-bottom: 30px;
            }

        .btn-home {
            background-color: #457b9d;
            color: white;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            transition: background 0.3s;
        }

            .btn-home:hover {
                background-color: #345873;
            }
    </style>
}

<div class="success-wrapper">
    <div class="success-box">
        <h2>Đăng ký thành công!</h2>
        <p>
            Xin hãy đợi admin phê duyệt.<br />
            Tài khoản sẽ được gửi về email bạn đã đăng ký.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn-home">Quay về Trang chủ</a>
    </div>
</div>
