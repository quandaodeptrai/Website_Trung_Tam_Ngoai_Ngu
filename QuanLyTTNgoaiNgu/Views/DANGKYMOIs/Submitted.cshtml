@{
    ViewData["Title"] = "Đăng ký thành công";
    Layout = "_LayoutTrangChu";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .success-container {
            max-width: 900px;
            margin: 60px auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204, 0, 0, 0.2);
            display: flex;
            overflow: hidden;
        }

        /* Cột ảnh bên trái */
        .success-image {
            flex: 1;
            min-width: 320px;
            background: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80') center/cover no-repeat;
        }

        /* Cột thông báo bên phải */
        .success-box {
            flex: 1;
            padding: 48px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            text-align: center;
        }

            .success-box h2 {
                color: #b30000;
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 20px;
            }

            .success-box p {
                font-size: 18px;
                color: #333;
                margin-bottom: 30px;
            }

        .btn-home {
            background: #cc0000;
            color: #fff;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 6px;
            text-decoration: none;
            transition: 0.3s;
            box-shadow: 0 5px 10px rgba(204,0,0,0.3);
            display: inline-block;
        }

            .btn-home:hover {
                background: #990000;
            }

        @@media (max-width: 768px) {
            .success-container {
                flex-direction: column;
                margin: 20px auto 40px;
            }

            .success-image {
                height: 200px;
            }

            .success-box {
                padding: 32px 24px;
            }
        }
    </style>
}

<div class="success-container">
    <!-- Cột ảnh bên trái -->
    <div class="success-image"></div>

    <!-- Cột thông báo bên phải -->
    <div class="success-box">
        <h2>Đăng ký thành công!</h2>
        <p>
            Xin hãy đợi admin phê duyệt.<br />
            Tài khoản sẽ được gửi về email bạn đã đăng ký.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn-home">Quay về Trang chủ</a>
    </div>
</div>