@model QuanLyTTNgoaiNgu.Models.DANGKYMOI

@{
    ViewData["Title"] = "Đăng ký học viên mới";
    Layout = "_LayoutTrangChu";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-container {
            max-width: 900px;
            margin: 40px auto 60px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204, 0, 0, 0.2);
            display: flex;
            overflow: hidden;
        }

        /* Cột ảnh bên trái */
        .register-image {
            flex: 1;
            min-width: 320px;
            background: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80') center/cover no-repeat;
        }

        /* Cột form bên phải */
        .register-form {
            flex: 1;
            padding: 48px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .register-form h2 {
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 28px;
                color: #b30000;
                text-align: center;
            }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #660000;
        }

        input[type="text"],
        input[type="email"],
        input[type="date"] {
            width: 100%;
            padding: 12px 14px;
            font-size: 16px;
            border-radius: 8px;
            border: 1.8px solid #cc0000;
            margin-bottom: 18px;
            transition: 0.3s ease;
            outline: none;
        }

            input[type="text"]:focus,
            input[type="email"]:focus,
            input[type="date"]:focus {
                border-color: #990000;
                box-shadow: 0 0 6px rgba(204, 0, 0, 0.5);
            }

        .btn-register {
            width: 100%;
            background: #cc0000;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 12px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 5px 10px rgba(204, 0, 0, 0.3);
        }

            .btn-register:hover {
                background: #990000;
            }

        .btn-cancel {
            display: block;
            width: 100%;
            text-align: center;
            margin-top: 12px;
            padding: 12px;
            background: #e63946;
            color: #fff;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-cancel:hover {
                background: #c92a35;
            }

        .text-danger {
            background: #ffe6e6;
            color: #b30000;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            box-shadow: 0 2px 5px rgba(204, 0, 0, 0.3);
        }

        @@media (max-width: 768px) {
            .register-container {
                flex-direction: column;
                margin: 20px auto 40px;
            }

            .register-image {
                height: 200px;
            }

            .register-form {
                padding: 32px 24px;
            }
        }
    </style>
}

<div class="register-container">

    <!-- Cột ảnh bên trái -->
    <div class="register-image"></div>

    <!-- Cột form bên phải -->
    <div class="register-form">
        <h2>Đăng ký học viên mới</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger">
                @ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage
            </div>
        }

        <form asp-action="Create" method="post">
            <label asp-for="HoTen">Họ và tên <span style="color: red;">*</span></label>
            <input asp-for="HoTen" placeholder="Nhập họ và tên..." required />
            <span asp-validation-for="HoTen" class="text-danger"></span>

            <label asp-for="NgaySinh">Ngày sinh <span style="color: red;">*</span></label>
            <input asp-for="NgaySinh" type="date" required />
            <span asp-validation-for="NgaySinh" class="text-danger"></span>

            <label asp-for="SoDienThoai">Số điện thoại <span style="color: red;">*</span></label>
            <input asp-for="SoDienThoai" placeholder="Số điện thoại..." required />
            <span asp-validation-for="SoDienThoai" class="text-danger"></span>

            <label asp-for="DiaChi">Địa chỉ <span style="color: red;">*</span></label>
            <input asp-for="DiaChi" placeholder="Địa chỉ..." required />
            <span asp-validation-for="DiaChi" class="text-danger"></span>

            <label asp-for="Email">Email <span style="color: red;">*</span></label>
            <input asp-for="Email" placeholder="Email..." required />
            <span asp-validation-for="Email" class="text-danger"></span>

            <button type="submit" class="btn-register">Gửi đăng ký</button>

            <a asp-controller="Home" asp-action="Index" class="btn-cancel">Hủy</a>
        </form>
    </div>

</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}