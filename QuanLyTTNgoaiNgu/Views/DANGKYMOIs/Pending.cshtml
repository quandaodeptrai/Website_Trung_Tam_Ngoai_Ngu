@model IEnumerable<QuanLyTTNgoaiNgu.Models.DANGKYMOI>
@{
    ViewData["Title"] = "Đăng ký chưa duyệt";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h2 {
            margin-bottom: 25px;
            color: #1d3557;
            font-weight: bold;
            text-align: center;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            background-color: #ffffff;
        }

            .custom-table thead {
                background-color: #1d3557;
                color: #ffffff;
            }

            .custom-table th,
            .custom-table td {
                padding: 14px;
                text-align: center;
                border-bottom: 1px solid #ddd;
            }

            .custom-table tbody tr:hover {
                background-color: #f9f9f9;
            }

        .btn-approve {
            background-color: #4CAF50;
            color: white;
            padding: 8px 16px;
            font-size: 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s ease;
        }

            .btn-approve:hover {
                background-color: #3e8e41;
            }
    </style>
}

<h2>@ViewData["Title"]</h2>

<table class="custom-table">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Điện thoại</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Hành động</th> <!-- Thêm cột hành động -->
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.MaDangKy</td>
                <td>@d.HoTen</td>
                <td>@d.NgaySinh?.ToString("dd/MM/yyyy")</td>
                <td>@d.SoDienThoai</td>
                <td>@d.DiaChi</td>
                <td>@d.Email</td>
                <td>
                    <a asp-action="Approve" asp-route-id="@d.MaDangKy" class="btn-approve">Duyệt</a>
                </td>
            </tr>
        }
    </tbody>
</table>
