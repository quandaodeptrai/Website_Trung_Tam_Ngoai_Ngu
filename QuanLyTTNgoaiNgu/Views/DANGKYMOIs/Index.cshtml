@model IEnumerable<QuanLyTTNgoaiNgu.Models.DANGKYMOI>

@{
    ViewData["Title"] = "Danh sách đăng ký";
    Layout = "_LayoutAdmin";
}

<h2>@ViewData["Title"]</h2>

<div style="text-align:center; margin-bottom:20px;">
    <a asp-action="Pending" class="btn btn-duyet">Đăng ký chưa duyệt</a>
</div>

<table class="dk-table">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Điện thoại</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Trạng thái</th>
            <th>Hành động</th> <!-- Thêm cột hành động -->
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.HoTen</td>
                <td>@item.NgaySinh?.ToString("dd/MM/yyyy")</td>
                <td>@item.SoDienThoai</td>
                <td>@item.DiaChi</td>
                <td>@item.Email</td>
                <td>
                    @if (!item.DaDuyet)
                    {
                        <span class="text-warning">Chưa duyệt</span>
                    }
                    else
                    {
                        <span class="text-success">Đã duyệt</span>
                    }
                </td>
                <td>
                    @if (!item.DaDuyet)
                    {
                        <a asp-action="Approve" asp-route-id="@item.MaDangKy" class="btn btn-duyet">Duyệt</a>

                    }
                    else
                    {
                        <span class="text-success"> </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


<style>
    h2 {
        margin-bottom: 20px;
        color: #1d3557;
        font-weight: bold;
        text-align: center;
    }

    .dk-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff;
        box-shadow: 0 6px 12px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
    }

        .dk-table th {
            background-color: #1d3557;
            color: #fff;
            padding: 12px;
            text-align: center;
        }

        .dk-table td {
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid #eee;
        }

        .dk-table tbody tr:hover {
            background-color: #f8f8f8;
        }

    .btn-duyet {
        background-color: #1d3557;
        color: white;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: bold;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s ease, transform 0.2s ease;
        display: inline-block;
    }

        .btn-duyet:hover {
            background-color: #457b9d;
            transform: translateY(-2px);
            text-decoration: none;
        }
</style>
