@model IEnumerable<QuanLyTTNgoaiNgu.Models.DANGKYMOI>

@{
    ViewData["Title"] = "Danh sách đăng ký";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h2 {
            margin-bottom: 25px;
            color: #b30000;
            font-weight: 700;
            text-align: center;
            font-size: 28px;
        }

        .table-wrapper {
            max-width: 1000px;
            margin: 0 auto 60px;
            overflow-x: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204,0,0,0.2);
            padding: 20px;
        }

        .dk-table {
            width: 100%;
            border-collapse: collapse;
        }

            .dk-table th {
                background-color: #cc0000;
                color: #fff;
                padding: 12px;
                text-align: center;
            }

            .dk-table td {
                padding: 10px;
                text-align: center;
                border-bottom: 1px solid #eee;
            }

            .dk-table tbody tr:hover {
                background-color: #ffe6e6;
            }

        .btn-duyet {
            background-color: #cc0000;
            color: white;
            padding: 12px 28px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s ease, transform 0.2s ease;
            display: inline-block;
        }

            .btn-duyet:hover {
                background-color: #990000;
                transform: scale(1.05);
            }

        .action-button-container {
            text-align: center;
            margin-top: 30px;
        }

        @@media (max-width: 768px) {
            .table-wrapper {
                padding: 10px;
            }

            .dk-table th,
            .dk-table td {
                padding: 8px;
                font-size: 14px;
            }

            .btn-duyet {
                width: 100%;
                padding: 12px 0;
            }
        }

        .filter-container {
            max-width: 1000px;
            margin: 0 auto 25px;
            text-align: center;
        }

        .filter-form {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .filter-input {
            padding: 10px 14px;
            border: 1px solid #cc0000;
            border-radius: 8px;
            width: 220px;
            outline: none;
            transition: 0.25s;
        }

            .filter-input:focus {
                border-color: #990000;
                box-shadow: 0 0 6px rgba(153,0,0,0.4);
            }

        .btn-search {
            background-color: #cc0000;
            color: white;
            padding: 10px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

            .btn-search:hover {
                background-color: #990000;
                transform: scale(1.05);
            }

    </style>
}

<h2>@ViewData["Title"]</h2>
<div class="filter-container">
    <form method="get" asp-action="Index" asp-controller="DANGKYMOIs" class="filter-form">
        <input type="text" name="hoTen" value="@Context.Request.Query["hoTen"]"
               placeholder="Tìm theo họ tên..." class="filter-input" />

        <input type="text" name="dienThoai" value="@Context.Request.Query["dienThoai"]"
               placeholder="Tìm theo điện thoại..." class="filter-input" />

        <input type="text" name="email" value="@Context.Request.Query["email"]"
               placeholder="Tìm theo email..." class="filter-input" />

        <button type="submit" class="btn-search">Lọc</button>
    </form>
</div>


<div class="table-wrapper">
    <table class="dk-table">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Điện thoại</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.HoTen</td>
                    <td>@item.NgaySinh?.ToString("dd/MM/yyyy")</td>
                    <td>@item.SoDienThoai</td>
                    <td>@item.DiaChi</td>
                    <td>@item.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="action-button-container">
    <a asp-controller="DANGKYMOIs" asp-action="Pending" class="btn-duyet">
        Duyệt đăng ký mới
    </a>
</div>