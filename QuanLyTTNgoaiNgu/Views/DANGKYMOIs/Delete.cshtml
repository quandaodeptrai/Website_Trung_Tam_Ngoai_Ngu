@model QuanLyTTNgoaiNgu.Models.DANGKYMOI

@{
    ViewData["Title"] = "Xóa đăng ký";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .delete-container {
            max-width: 700px;
            margin: 50px auto 60px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204,0,0,0.2);
            padding: 40px 50px;
        }

        h2 {
            color: #b30000;
            font-weight: 700;
            margin-bottom: 30px;
            text-align: center;
            font-size: 28px;
        }

        dl.row dt {
            font-weight: 600;
            color: #660000;
        }

        dl.row dd {
            margin-bottom: 15px;
            color: #333;
        }

        .btn-delete {
            background-color: #cc0000;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 12px 25px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
        }

            .btn-delete:hover {
                background-color: #990000;
                transform: scale(1.05);
            }

        .btn-back {
            background-color: #6c757d;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 12px 25px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            margin-left: 15px;
            transition: background-color 0.3s, transform 0.2s;
        }

            .btn-back:hover {
                background-color: #5a6268;
                transform: scale(1.05);
            }

        @@media (max-width: 768px) {
            .delete-container {
                padding: 30px 20px;
            }

            .btn-delete, .btn-back {
                width: 100%;
                margin: 8px 0;
            }
        }
    </style>
}

<div class="delete-container">
    <h2>Xóa đăng ký</h2>

    <p>Bạn có chắc chắn muốn xóa đăng ký này không?</p>

    <dl class="row">
        <dt class="col-sm-4">Họ tên</dt>
        <dd class="col-sm-8">@Model.HoTen</dd>

        <dt class="col-sm-4">Ngày sinh</dt>
        <dd class="col-sm-8">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-4">Điện thoại</dt>
        <dd class="col-sm-8">@Model.SoDienThoai</dd>

        <dt class="col-sm-4">Địa chỉ</dt>
        <dd class="col-sm-8">@Model.DiaChi</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MaDangKy" />
        <button type="submit" class="btn-delete">Xóa</button><a asp-action="Index" class="btn-back">Quay lại danh sách</a>
    </form>
</div>