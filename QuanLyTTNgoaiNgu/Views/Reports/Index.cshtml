﻿@{
ViewData["Title"] = "Báo cáo – Thống kê";
Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        .report-dashboard {
            max-width: 1100px;
            margin: 40px auto;
        }

        h2 {
            text-align: center;
            color: #c62828;
            font-weight: 700;
            margin-bottom: 30px;
        }

        .report-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .report-card {
            background: #fff5f5;
            border-left: 6px solid #c62828;
            border-radius: 12px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, background 0.3s ease;
            cursor: pointer;
        }

            .report-card:hover {
                background: #ffeaea;
                transform: translateY(-5px);
            }

            .report-card i {
                font-size: 40px;
                color: #c62828;
                margin-bottom: 12px;
            }

            .report-card h4 {
                margin-bottom: 8px;
                color: #c62828;
                font-weight: 600;
            }

            .report-card p {
                font-size: 14px;
                color: #555;
            }
    </style>
}

<div class="report-dashboard">
    <h2>Báo cáo – Thống kê</h2>

    <div class="report-grid">
        <a asp-action="Detail" asp-route-type="HocVien" class="report-card">
            <i class="fas fa-user-graduate"></i>
            <h4>Học viên</h4>
            <p>Số lượng học viên, học viên chưa đăng ký lớp</p>
        </a>

        <a asp-action="Detail" asp-route-type="LopHoc" class="report-card">
            <i class="fas fa-chalkboard-teacher"></i>
            <h4>Lớp học</h4>
            <p>Số học viên theo lớp, giảng viên phụ trách</p>
        </a>

        <a asp-action="Detail" asp-route-type="KhoaHoc" class="report-card">
            <i class="fas fa-book"></i>
            <h4>Khóa học</h4>
            <p>Số lớp, số học viên, doanh thu theo khóa</p>
        </a>

        <a asp-action="Detail" asp-route-type="DoanhThu" class="report-card">
            <i class="fas fa-coins"></i>
            <h4>Doanh thu</h4>
            <p>Tổng doanh thu, theo lớp, theo khóa học</p>
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a2d04d4f1d.js" crossorigin="anonymous"></script>
}