@model QuanLyTTNgoaiNgu.Models.KHOAHOC

@{
    ViewData["Title"] = "Chi tiết Khóa học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: #fefefe;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #c62828;
            text-align: center;
            font-weight: 700;
            text-transform: uppercase;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

            h1 i {
                color: #c62828;
            }

        .card {
            background-color: #fff;
            padding: 35px 40px;
            border-radius: 14px;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
            max-width: 700px;
            margin: 0 auto;
            border-top: 6px solid #c62828;
            transition: 0.3s ease;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(198, 40, 40, 0.2);
            }

        .section-title {
            color: #c62828;
            font-weight: 600;
            margin-bottom: 20px;
            text-align: center;
            font-size: 18px;
            text-transform: uppercase;
        }

        dl.row dt {
            font-weight: 600;
            color: #c62828;
            margin-top: 10px;
        }

        dl.row dd {
            color: #333;
            margin-bottom: 10px;
        }

        hr {
            border-top: 2px solid #eee;
            margin: 20px 0;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 600;
            border-radius: 6px;
            transition: all 0.3s ease;
            border: none;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(90deg, #c62828, #e53935);
            color: white;
            box-shadow: 0 3px 8px rgba(198, 40, 40, 0.3);
        }

            .btn-primary:hover {
                background: linear-gradient(90deg, #b71c1c, #d32f2f);
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #9e9e9e;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #757575;
                transform: translateY(-2px);
            }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 25px;
        }
    </style>
}

<h1><i class="fa-solid fa-circle-info"></i> @ViewData["Title"]</h1>

<div class="card">
    <h4 class="section-title"><i class="fa-solid fa-book"></i> Thông tin khóa học</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3"><i class="fa-solid fa-chalkboard"></i> Tên khóa học</dt>
        <dd class="col-sm-9">@Model.TenKhoaHoc</dd>

        <dt class="col-sm-3"><i class="fa-solid fa-align-left"></i> Mô tả</dt>
        <dd class="col-sm-9">@Model.MoTa</dd>

        <dt class="col-sm-3"><i class="fa-solid fa-coins"></i> Mức học phí</dt>
        <dd class="col-sm-9">@Model.MucHocPhi.ToString("N0") VNĐ</dd>
    </dl>

    <div class="btn-group">
        <a asp-action="Edit" asp-route-id="@Model.MaKhoaHoc" class="btn btn-primary">
            <i class="fa-solid fa-pen-to-square"></i> Sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>