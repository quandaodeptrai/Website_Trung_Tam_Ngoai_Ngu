@model QuanLyTTNgoaiNgu.Models.KHOAHOC

@{
    ViewData["Title"] = "Thêm Khóa học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #1d3557;
        }

        form {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 12px;
            max-width: 600px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-bottom: 6px;
            color: #1d3557;
        }

        input[type="text"],
        input[type="number"],
        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        .text-danger {
            color: #e63946;
            font-size: 14px;
        }

        .btn {
            display: inline-block;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 600;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .btn-success {
            background-color: #2a9d8f;
            color: white;
            border: none;
        }

            .btn-success:hover {
                background-color: #21867a;
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
            }

        .form-wrapper {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }
    </style>
}

<h1>@ViewData["Title"]</h1>

<div class="form-wrapper">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="TenKhoaHoc"></label>
            <input asp-for="TenKhoaHoc" />
            <span asp-validation-for="TenKhoaHoc" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MoTa"></label>
            <input asp-for="MoTa" />
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MucHocPhi"></label>
            <input asp-for="MucHocPhi" type="number" />
            <span asp-validation-for="MucHocPhi" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Thêm</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
