@model QuanLyTTNgoaiNgu.Models.KHOAHOC

@{
    ViewData["Title"] = "Thêm Khóa học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: #fefefe;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #c62828;
            text-align: center;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

            h1 i {
                color: #c62828;
            }

        .form-wrapper {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

        form {
            background-color: #ffffff;
            padding: 35px 40px;
            border-radius: 14px;
            max-width: 600px;
            width: 100%;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
            border-top: 6px solid #c62828;
            transition: 0.3s ease;
        }

            form:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(198, 40, 40, 0.2);
            }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: 600;
            display: block;
            margin-bottom: 8px;
            color: #c62828;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        input[type="text"],
        input[type="number"],
        textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 15px;
            transition: 0.3s ease;
        }

            input:focus,
            textarea:focus {
                border-color: #c62828;
                box-shadow: 0 0 5px rgba(198, 40, 40, 0.4);
                outline: none;
            }

        .text-danger {
            color: #c62828;
            font-size: 14px;
            margin-top: 4px;
            display: block;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-success {
            background: linear-gradient(90deg, #c62828, #e53935);
            color: white;
            box-shadow: 0 3px 8px rgba(198, 40, 40, 0.3);
        }

            .btn-success:hover {
                background: linear-gradient(90deg, #b71c1c, #d32f2f);
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #9e9e9e;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #757575;
                transform: translateY(-2px);
            }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
        }

        .validation-summary-errors {
            background-color: #ffebee;
            border-left: 5px solid #c62828;
            color: #c62828;
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }
    </style>
}

<h1><i class="fa-solid fa-circle-plus"></i> @ViewData["Title"]</h1>

<div class="form-wrapper">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="TenKhoaHoc"><i class="fa-solid fa-book"></i> Tên Khóa học</label>
            <input asp-for="TenKhoaHoc" placeholder="Nhập tên khóa học..." />
            <span asp-validation-for="TenKhoaHoc" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MoTa"><i class="fa-solid fa-align-left"></i> Mô tả</label>
            <textarea asp-for="MoTa" rows="3" placeholder="Nhập mô tả khóa học..."></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MucHocPhi"><i class="fa-solid fa-coins"></i> Mức học phí (VNĐ)</label>
            <input asp-for="MucHocPhi" type="number" placeholder="Nhập học phí..." />
            <span asp-validation-for="MucHocPhi" class="text-danger"></span>
        </div>

        <div class="btn-group">
            <button type="submit" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i> Thêm
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-xmark"></i> Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}