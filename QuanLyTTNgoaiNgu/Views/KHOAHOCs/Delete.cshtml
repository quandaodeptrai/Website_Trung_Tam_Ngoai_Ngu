@model QuanLyTTNgoaiNgu.Models.KHOAHOC

@{
    ViewData["Title"] = "Xóa Khóa học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            margin-bottom: 20px;
            color: #1d3557;
        }

        .card {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
            max-width: 700px;
        }

        dl.row {
            margin-bottom: 20px;
        }

        dt {
            font-weight: bold;
            color: #333;
        }

        dd {
            color: #555;
        }

        .text-danger {
            color: #e63946;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 600;
            border-radius: 6px;
            transition: background-color 0.3s ease;
            margin-right: 10px;
        }

        .btn-danger {
            background-color: #e63946;
            color: white;
            border: none;
        }

            .btn-danger:hover {
                background-color: #c1272d;
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
            }
    </style>
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <h4 class="text-danger">Bạn có chắc chắn muốn xóa khóa học này?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Tên khóa học</dt>
        <dd class="col-sm-9">@Model.TenKhoaHoc</dd>

        <dt class="col-sm-3">Mô tả</dt>
        <dd class="col-sm-9">@Model.MoTa</dd>

        <dt class="col-sm-3">Mức học phí</dt>
        <dd class="col-sm-9">@Model.MucHocPhi.ToString("N0") VNĐ</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaKhoaHoc" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>
