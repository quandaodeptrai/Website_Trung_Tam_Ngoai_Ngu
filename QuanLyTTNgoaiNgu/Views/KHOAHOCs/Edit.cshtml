@model QuanLyTTNgoaiNgu.Models.KHOAHOC

@{
    ViewData["Title"] = "Chỉnh sửa Khóa học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: #fefefe;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #c62828;
            text-align: center;
            font-weight: 700;
            text-transform: uppercase;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

            h1 i {
                color: #c62828;
            }

        form {
            background-color: #fff;
            padding: 35px 40px;
            border-radius: 14px;
            max-width: 700px;
            margin: 0 auto;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
            border-top: 6px solid #c62828;
            transition: 0.3s ease;
        }

            form:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(198, 40, 40, 0.2);
            }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
            color: #c62828;
        }

        input[type="text"],
        input[type="number"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        input:focus {
            border-color: #c62828;
            outline: none;
            box-shadow: 0 0 4px rgba(198, 40, 40, 0.4);
        }

        .text-danger {
            color: #e53935;
            font-size: 14px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 600;
            border-radius: 6px;
            transition: all 0.3s ease;
            border: none;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(90deg, #c62828, #e53935);
            color: white;
            box-shadow: 0 3px 8px rgba(198, 40, 40, 0.3);
        }

            .btn-primary:hover {
                background: linear-gradient(90deg, #b71c1c, #d32f2f);
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #9e9e9e;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #757575;
                transform: translateY(-2px);
            }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 25px;
        }
    </style>
}

<h1><i class="fa-solid fa-pen-to-square"></i> @ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaKhoaHoc" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-group">
        <label asp-for="TenKhoaHoc"><i class="fa-solid fa-chalkboard"></i> Tên khóa học</label>
        <input asp-for="TenKhoaHoc" class="form-control" />
        <span asp-validation-for="TenKhoaHoc" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MoTa"><i class="fa-solid fa-align-left"></i> Mô tả</label>
        <input asp-for="MoTa" class="form-control" />
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MucHocPhi"><i class="fa-solid fa-coins"></i> Mức học phí</label>
        <input asp-for="MucHocPhi" type="number" min="0" step="10000" class="form-control" />
        <span asp-validation-for="MucHocPhi" class="text-danger"></span>
    </div>

    <div class="btn-group">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Lưu
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}