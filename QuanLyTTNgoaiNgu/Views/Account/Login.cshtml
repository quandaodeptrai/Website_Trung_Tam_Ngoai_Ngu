﻿@{
ViewData["Title"] = "Đăng nhập";
Layout = "_LayoutTrangChu"; // Giữ nguyên layout
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            max-width: 900px;
            margin: 40px auto 60px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204, 0, 0, 0.2);
            display: flex;
            overflow: hidden;
        }

        /* Cột ảnh bên trái */
        .login-image {
            flex: 1;
            min-width: 320px;
            background: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80') center/cover no-repeat;
        }

        /* Cột form bên phải */
        .login-form {
            flex: 1;
            padding: 48px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-form h2 {
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 28px;
                color: #b30000;
            }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #660000;
        }

        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 12px 14px;
            font-size: 16px;
            border-radius: 8px;
            border: 1.8px solid #cc0000;
            margin-bottom: 18px;
            transition: 0.3s ease;
            outline: none;
        }

            input[type="text"]:focus,
            input[type="password"]:focus {
                border-color: #990000;
                box-shadow: 0 0 6px rgba(204, 0, 0, 0.5);
            }

        .form-remember {
            text-align: center;
            justify-content: space-between;
            margin: 20px;
            flex-wrap: wrap;
        }

            .form-remember label {
                font-weight: 500;
                color: #660000;
                font-size: 14px;
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .form-remember input[type="checkbox"] {
                accent-color: #cc0000;
                cursor: pointer;
            }

        .forgot-link {
            color: #cc0000;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
        }

            .forgot-link:hover {
                color: #990000;
                text-decoration: underline;
            }

        .btn-login {
            width: 100%;
            background: #cc0000;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 12px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 5px 10px rgba(204, 0, 0, 0.3);
        }

            .btn-login:hover {
                background: #990000;
            }

        .register-prompt {
            text-align: center;
            font-size: 14px;
            color: #660000;
        }

            .register-prompt a {
                color: #cc0000;
                font-weight: 700;
                text-decoration: none;
            }

                .register-prompt a:hover {
                    color: #990000;
                    text-decoration: underline;
                }

        .text-danger {
            background: #ffe6e6;
            color: #b30000;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            box-shadow: 0 2px 5px rgba(204, 0, 0, 0.3);
        }

        @@media (max-width: 768px) {
            .login-container {
                flex-direction: column;
                margin: 20px auto 40px;
            }

            .login-image {
                height: 200px;
            }

            .login-form {
                padding: 32px 24px;
            }
        }
    </style>
}

<div class="login-container">

    <!-- Cột ảnh bên trái -->
    <div class="login-image"></div>

    <!-- Cột form bên phải -->
    <div class="login-form">
        <h2>Đăng nhập</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger">
                @ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage
            </div>
        }

        <form method="post" asp-action="Login">
            <label for="username">Tên đăng nhập hoặc Email <span style="color: red;">*</span></label>
            <input type="text" id="username" name="username" placeholder="Nhập tên đăng nhập hoặc email" required />

            <label for="password">Mật khẩu <span style="color: red;">*</span></label>
            <input type="password" id="password" name="password" placeholder="Nhập mật khẩu" required />

            <button type="submit" class="btn-login">Đăng nhập</button>
          
        </form>
        <div class="form-remember">
            <a class="forgot-link" asp-action="QuenMatKhau">Quên mật khẩu?</a>
        </div>

        <div class="register-prompt">
            Bạn chưa có tài khoản? <a href="/DANGKYMOIs/Create">Đăng ký</a>
        </div>
       
    </div>

</div>