@{
    Layout = "_LayoutTrangChu";
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <style>
        body {
            background: #f0f4f8;
            font-family: 'Segoe UI', sans-serif;
        }

        .forgot-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
            padding: 20px;
        }

        .forgot-box {
            background: #fff;
            border-radius: 16px;
            padding: 40px 30px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            text-align: center;
        }

            .forgot-box h2 {
                font-size: 28px;
                color: #1d3557;
                margin-bottom: 25px;
                font-weight: 700;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group input {
                width: 100%;
                padding: 14px;
                border-radius: 8px;
                border: 1px solid #ccc;
                font-size: 16px;
                transition: 0.3s;
            }

                .form-group input:focus {
                    border-color: #457b9d;
                    outline: none;
                    box-shadow: 0 0 5px rgba(69,123,157,0.4);
                }

        .btn-forgot {
            width: 100%;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(to right, #457b9d, #1d3557);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-forgot:hover {
                background: linear-gradient(to right, #1d3557, #457b9d);
            }

        .footer-link {
            margin-top: 20px;
        }

            .footer-link a {
                color: #457b9d;
                text-decoration: none;
                font-weight: 600;
            }

                .footer-link a:hover {
                    text-decoration: underline;
                }

        .alert {
            margin-bottom: 15px;
            font-weight: 600;
        }

        .text-danger {
            color: #e63946;
        }

        .text-success {
            color: #2a9d8f;
        }
    </style>
}

<div class="forgot-wrapper">
    <div class="forgot-box">
        <h2>Quên mật khẩu</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert text-danger">@ViewBag.Error</div>
        }
        @if (ViewBag.Message != null)
        {
            <div class="alert text-success">@ViewBag.Message</div>
        }

        <form method="post" asp-action="QuenMatKhau">
            <div class="form-group">
                <input type="email" name="email" placeholder="Nhập email đăng ký" required />
            </div>

            <button type="submit" class="btn-forgot">Khôi phục mật khẩu</button>

            <div class="footer-link">
                <a asp-action="Login">← Quay lại trang đăng nhập</a>
            </div>
        </form>
    </div>
</div>
