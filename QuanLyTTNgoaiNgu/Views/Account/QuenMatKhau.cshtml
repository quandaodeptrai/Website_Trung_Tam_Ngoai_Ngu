@{
    Layout = "_LayoutTrangChu";
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <style>
        .forgot-wrapper {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 80vh;
        }

        .forgot-box {
            background: #fff;
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }

            .forgot-box h2 {
                text-align: center;
                margin-bottom: 25px;
                font-weight: 700;
                color: #1d3557;
            }

        .form-group input {
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            width: 100%;
            margin-bottom: 15px;
            border: 1px solid #ddd;
        }

        .btn-forgot {
            width: 100%;
            background: #ff9933;
            color: white;
            padding: 14px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            margin-top: 15px;
            transition: background 0.3s;
        }

            .btn-forgot:hover {
                background: #e28525;
            }

        .footer-link {
            margin-top: 15px;
            text-align: center;
        }

            .footer-link a {
                color: #1d3557;
                font-weight: 600;
                text-decoration: none;
            }

                .footer-link a:hover {
                    text-decoration: underline;
                }
        .text-danger, .text-success {
            text-align: center;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .text-danger {
            color: red;
        }

        .text-success {
            color: green;
        }
    </style>
}

<div class="forgot-wrapper">
    <div class="forgot-box">
        <h2>Quên mật khẩu</h2>

        @if (ViewBag.Error != null)
        {
            <div class="text-danger">@ViewBag.Error</div>
        }
        @if (ViewBag.Message != null)
        {
            <div class="text-success">@ViewBag.Message</div>
        }

        <form method="post" asp-action="QuenMatKhau">
            <div class="form-group">
                <input type="text" name="username" placeholder="Tên đăng nhập" required />
            </div>
            <div class="form-group">
                <input type="email" name="email" placeholder="Email đăng ký" required />
            </div>
            <button type="submit" class="btn-forgot">Khôi phục mật khẩu</button>
            <div class="footer-link">
                <a asp-action="Login">Quay lại trang đăng nhập</a>
            </div>
        </form>

    </div>
</div>
