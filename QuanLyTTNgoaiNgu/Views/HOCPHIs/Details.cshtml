@model QuanLyTTNgoaiNgu.Models.HOCPHI

@{
    ViewData["Title"] = "Chi tiết Học phí";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            color: #1d3557;
            margin-bottom: 25px;
            text-align: center;
        }

        .details-container {
            background-color: #fff;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
            max-width: 650px;
            margin: 0 auto;
        }

        dt {
            font-weight: 600;
            color: #343a40;
            margin-top: 10px;
        }

        dd {
            margin-bottom: 15px;
            color: #495057;
        }

        .btn-group {
            margin-top: 30px;
            text-align: center;
        }

        .btn {
            text-decoration: none !important;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: capitalize;
            border: none;
        }

        .btn-primary {
            background-color: #3a86ff;
            color: white;
        }

            .btn-primary:hover {
                background-color: #2b6ed3;
            }

        .btn-secondary {
            background-color: #adb5bd;
            color: white;
            margin-left: 10px;
        }

            .btn-secondary:hover {
                background-color: #919ca6;
            }
    </style>
}


<h1>@ViewData["Title"]</h1>

<div class="details-container">
    <dl class="row">
        <dt class="col-sm-4">Mã phiếu đăng ký</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.MaPhieu</dd>

        <dt class="col-sm-4">Mã học viên</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.HOCVIEN?.MaHocVien</dd>

        <dt class="col-sm-4">Họ tên học viên</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.HOCVIEN?.DANGKYMOI?.HoTen</dd>

        <dt class="col-sm-4">Số tiền</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.LOPHOC?.KHOAHOC?.MucHocPhi.ToString("N0") VNĐ</dd>

        <dt class="col-sm-4">Ngày nộp</dt>
        <dd class="col-sm-8">
            @(Model.NgayNop.HasValue ? Model.NgayNop.Value.ToString("dd/MM/yyyy") : "Chưa nộp")
        </dd>

        <dt class="col-sm-4">Trạng thái</dt>
        <dd class="col-sm-8">
            @(Model.TrangThai ? "Đã thanh toán" : "Chưa thanh toán")
        </dd>
    </dl>

</div>

<div class="btn-group">
    <a asp-action="Edit" asp-route-id="@Model?.MaHocPhi" class="btn btn-primary">Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>
