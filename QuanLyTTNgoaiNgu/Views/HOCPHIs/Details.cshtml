@model QuanLyTTNgoaiNgu.Models.HOCPHI

@{
    ViewData["Title"] = "Chi tiết Học phí";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: #fefefe;
        }

        h1 {
            font-size: 28px;
            color: #c62828;
            margin-bottom: 30px;
            text-align: center;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

            h1 i {
                color: #c62828;
            }

        .details-container {
            background-color: #fff;
            padding: 35px 45px;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
            max-width: 700px;
            margin: 0 auto;
            border-top: 6px solid #c62828;
        }

        dl {
            margin: 0;
        }

        dt {
            font-weight: 600;
            color: #c62828;
            margin-top: 10px;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        dd {
            margin-bottom: 15px;
            color: #444;
            font-size: 15px;
            padding-left: 25px;
        }

            dd span {
                font-weight: 600;
            }

        .paid {
            color: #2e7d32;
        }

        .unpaid {
            color: #c62828;
        }

        .btn-group {
            margin-top: 35px;
            text-align: center;
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .btn {
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background-color: #ef5350;
            color: white;
        }

            .btn-primary:hover {
                background-color: #c62828;
                transform: translateY(-1px);
            }

        .btn-secondary {
            background-color: #adb5bd;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #888f96;
                transform: translateY(-1px);
            }

        .details-container:hover {
            transform: translateY(-2px);
            transition: 0.3s ease;
        }
    </style>
}

<h1><i class="fa-solid fa-money-check-dollar"></i> @ViewData["Title"]</h1>

<div class="details-container">
    <dl class="row">
        <dt class="col-sm-4"><i class="fa-solid fa-id-card"></i> Mã phiếu đăng ký</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.MaPhieu</dd>

        <dt class="col-sm-4"><i class="fa-solid fa-user"></i> Mã học viên</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.HOCVIEN?.MaHocVien</dd>

        <dt class="col-sm-4"><i class="fa-solid fa-user-graduate"></i> Họ tên học viên</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.HOCVIEN?.DANGKYMOI?.HoTen</dd>

        <dt class="col-sm-4"><i class="fa-solid fa-coins"></i> Số tiền</dt>
        <dd class="col-sm-8">@Model.PHIEUDANGKY?.LOPHOC?.KHOAHOC?.MucHocPhi.ToString("N0") VNĐ</dd>

        <dt class="col-sm-4"><i class="fa-solid fa-calendar-day"></i> Ngày nộp</dt>
        <dd class="col-sm-8">
            @(Model.NgayNop.HasValue? Model.NgayNop.Value.ToString("dd/MM/yyyy") : "Chưa nộp")
        </dd>

        <dt class="col-sm-4"><i class="fa-solid fa-clipboard-check"></i> Trạng thái</dt>
        <dd class="col-sm-8">
            @if (Model.TrangThai)
            {
                <span class="paid"><i class="fa-solid fa-circle-check"></i> Đã thanh toán</span>
            }
            else
            {
                <span class="unpaid"><i class="fa-solid fa-circle-xmark"></i> Chưa thanh toán</span>
            }
        </dd>
    </dl>
</div>

<div class="btn-group">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
    </a>
</div>