@model QuanLyTTNgoaiNgu.Models.TAIKHOAN

@{
    ViewData["Title"] = "Chi tiết tài khoản";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .details-container {
            max-width: 600px;
            margin: 40px auto;
            background: #fff;
            padding: 30px 40px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204,0,0,0.2);
        }

            .details-container h2 {
                text-align: center;
                font-size: 28px;
                color: #b30000;
                margin-bottom: 30px;
                font-weight: 700;
            }

        dl {
            display: flex;
            flex-wrap: wrap;
        }

        dt {
            flex: 0 0 40%;
            font-weight: 600;
            color: #343a40;
            margin-bottom: 10px;
        }

        dd {
            flex: 0 0 60%;
            margin-bottom: 10px;
            padding: 8px 12px;
            background: #ffe6e6;
            border-radius: 8px;
            color: #495057;
        }

        .actions {
            text-align: center;
            margin-top: 30px;
        }

            .actions a {
                display: inline-block;
                padding: 12px 28px;
                font-size: 16px;
                font-weight: 600;
                border-radius: 8px;
                text-decoration: none;
                color: #fff;
                margin: 5px;
                transition: background-color 0.3s ease, transform 0.2s ease;
            }

                .actions a:first-child {
                    background-color: #cc0000;
                }

                    .actions a:first-child:hover {
                        background-color: #990000;
                        transform: scale(1.05);
                    }

                .actions a:last-child {
                    background-color: #b3b3b3;
                }

                    .actions a:last-child:hover {
                        background-color: #999999;
                        transform: scale(1.05);
                    }

        @@media (max-width: 768px) {
            dl

        {
            flex-direction: column;
        }

        dt, dd {
            flex: 0 0 100%;
        }

        .actions a {
            width: 100%;
            padding: 12px 0;
            margin-bottom: 10px;
        }

        }
    </style>
}

<div class="details-container">
    <h2>@ViewData["Title"]</h2>

    <dl>
        <dt>Tên đăng nhập</dt>
        <dd>@Model.TenDangNhap</dd>

        <dt>Mật khẩu</dt>
        <dd>@Model.MatKhau</dd>

        <dt>Vai trò</dt>
        <dd>@Model.VaiTro</dd>
    </dl>

    <div class="actions">
        <a asp-action="Edit" asp-route-id="@Model?.MaTaiKhoan">Chỉnh sửa</a>
        <a asp-action="Index">Quay lại danh sách</a>
    </div>
</div>