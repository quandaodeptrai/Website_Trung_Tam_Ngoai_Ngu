@model QuanLyTTNgoaiNgu.Models.TAIKHOAN

@{
    ViewData["Title"] = "Chi tiết tài khoản";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        .details-container {
            max-width: 600px;
            margin: 40px auto;
            background: #ffffff;
            padding: 30px 40px;
            border-radius: 16px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            font-family: 'Segoe UI', sans-serif;
        }

            .details-container h1 {
                text-align: center;
                font-size: 28px;
                color: #1d3557;
                margin-bottom: 30px;
            }

            .details-container dt {
                font-weight: bold;
                color: #333;
                margin-top: 15px;
            }

            .details-container dd {
                margin-left: 0;
                padding: 6px 12px;
                background: #f1f5f9;
                border-radius: 8px;
            }

            .details-container .actions {
                margin-top: 30px;
                text-align: center;
            }

                .details-container .actions a {
                    margin: 0 10px;
                    text-decoration: none;
                    padding: 10px 20px;
                    background-color: #1d3557;
                    color: white;
                    border-radius: 8px;
                    transition: background 0.3s;
                }

                    .details-container .actions a:hover {
                        background-color: #457b9d;
                    }
    </style>
}

<div class="details-container">
    <h1>Chi tiết tài khoản</h1>

    <dl>
        <dt>Tên đăng nhập</dt>
        <dd>@Model.TenDangNhap</dd>

        <dt>Mật khẩu</dt>
        <dd>@Model.MatKhau</dd>

        <dt>Vai trò</dt>
        <dd>@Model.VaiTro</dd>
    </dl>

    <div class="actions">
        <a asp-action="Edit" asp-route-id="@Model?.MaTaiKhoan">Chỉnh sửa</a>
        <a asp-action="Index">Quay lại danh sách</a>
    </div>
</div>
