@model QuanLyTTNgoaiNgu.Models.TAIKHOAN

@{
    ViewData["Title"] = "Tạo Tài Khoản";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        .form-container {
            max-width: 500px;
            margin: 40px auto;
            background: #fff;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            font-size: 28px;
            color: #1d3557;
            margin-bottom: 20px;
        }

        label {
            font-weight: 600;
            margin-top: 15px;
        }

        .form-control {
            border-radius: 8px;
            padding: 10px;
            border: 1px solid #ccc;
            margin-bottom: 10px;
        }

        .btn-primary {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            background-color: #1d3557;
            border: none;
            color: white;
            font-weight: bold;
            transition: background .3s;
        }

            .btn-primary:hover {
                background-color: #457b9d;
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #1d3557;
            text-decoration: none;
        }

        .text-danger {
            font-size: 0.9em;
        }
    </style>
}

<div class="form-container">
    <h1>Tạo Tài Khoản</h1>

    @* Nếu có giảng viên được truyền sang (tạo từ form GIANGVIEN), hiển thị thông báo và thêm hidden field *@
    @if (ViewBag.GiangVienId != null)
    {
        <div class="alert alert-info">
            Tạo tài khoản cho giảng viên: <strong>@(ViewBag.SuggestedDisplayName ?? "(Không rõ tên)")</strong>
        </div>
    }

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* hidden field để POST giangVienId về controller nếu có *@
        @if (ViewBag.GiangVienId != null)
        {
            <input type="hidden" name="giangVienId" value="@ViewBag.GiangVienId" />
        }


        <div class="form-group">
            <label asp-for="TenDangNhap"></label>
            <input asp-for="TenDangNhap" class="form-control" />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MatKhau"></label>
            <input asp-for="MatKhau" class="form-control" type="password" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="VaiTro"></label>
            <select asp-for="VaiTro" class="form-control">
                <option value="GiangVien">Giảng viên</option>
            </select>
            <span asp-validation-for="VaiTro" class="text-danger"></span>
        </div>


        <div class="form-group">
            <input type="submit" value="Tạo tài khoản" class="btn btn-primary" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
