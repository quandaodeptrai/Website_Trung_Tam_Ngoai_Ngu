@model QuanLyTTNgoaiNgu.Models.TAIKHOAN

@{
    ViewData["Title"] = "Tạo Tài Khoản";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        .form-container {
            max-width: 500px;
            margin: 40px auto;
            background: #ffffff;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            font-size: 28px;
            color: #1d3557;
            margin-bottom: 20px;
        }

        label {
            font-weight: 600;
            margin-top: 15px;
        }

        .form-control {
            border-radius: 8px;
            padding: 10px;
            border: 1px solid #ccc;
            margin-bottom: 10px;
        }

        .btn-primary {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            background-color: #1d3557;
            border: none;
            color: white;
            font-weight: bold;
            transition: background 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #457b9d;
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #1d3557;
            text-decoration: none;
        }

        .text-danger {
            font-size: 0.9em;
        }
    </style>
}

<div class="form-container">
    <h1>Tạo Tài Khoản</h1>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="TenDangNhap"></label>
            <input asp-for="TenDangNhap" class="form-control" />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MatKhau"></label>
            <input asp-for="MatKhau" class="form-control" type="password" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="VaiTro"></label>
            <input asp-for="VaiTro" class="form-control" />
            <span asp-validation-for="VaiTro" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Tạo tài khoản" class="btn btn-primary" />
        </div>
    </form>

    <a asp-action="Index" class="back-link">← Quay lại danh sách</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
