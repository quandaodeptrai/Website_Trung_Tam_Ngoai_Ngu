@model QuanLyTTNgoaiNgu.Models.TAIKHOAN

@{
    ViewData["Title"] = "Cập nhật Tài khoản";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .edit-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 40px;
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204,0,0,0.2);
        }

        h2 {
            text-align: center;
            font-size: 28px;
            color: #b30000;
            margin-bottom: 30px;
            font-weight: 700;
        }

        label {
            font-weight: 600;
            color: #343a40;
            display: block;
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            background-color: #ffe6e6;
            margin-bottom: 20px;
            font-size: 15px;
        }

        .btn-primary {
            width: 100%;
            background-color: #cc0000;
            color: white;
            padding: 12px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

        .btn-primary:hover {
            background-color: #990000;
            transform: scale(1.03);
        }

        .text-danger {
            font-size: 14px;
            margin-top: -12px;
            margin-bottom: 15px;
            display: block;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #b30000;
            font-weight: 500;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        @@media (max-width: 768px) {
            .edit-container { padding: 30px 20px; }
            .btn-primary { font-size: 15px; padding: 10px; }
        }
    </style>
}

<div class="edit-container">
    <h2>@ViewData["Title"]</h2>
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="MaTaiKhoan" />

        <div class="form-group">
            <label asp-for="TenDangNhap"></label>
            <input asp-for="TenDangNhap" class="form-control" />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MatKhau"></label>
            <input asp-for="MatKhau" class="form-control" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="VaiTro"></label>
            <input asp-for="VaiTro" class="form-control" />
            <span asp-validation-for="VaiTro" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    </form>

    <a asp-action="Index" class="back-link">← Quay lại danh sách</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}