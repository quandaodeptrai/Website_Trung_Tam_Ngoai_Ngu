@model QuanLyTTNgoaiNgu.Models.TAIKHOAN

@{
    ViewData["Title"] = "Xóa tài khoản";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        .delete-container {
            background: #ffffff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            max-width: 600px;
            margin: 40px auto;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h1, h3 {
            text-align: center;
            color: #e63946;
        }

        h4 {
            text-align: center;
            color: #1d3557;
            margin-bottom: 30px;
        }

        dt {
            font-weight: bold;
            color: #457b9d;
        }

        dd {
            margin-bottom: 15px;
        }

        form {
            text-align: center;
            margin-top: 30px;
        }

        .btn-danger {
            background-color: #e63946;
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            color: #fff;
            font-weight: bold;
            margin-right: 10px;
        }

            .btn-danger:hover {
                background-color: #d62828;
            }

        a {
            color: #1d3557;
            text-decoration: none;
            font-weight: bold;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
}

<div class="delete-container">
    <h1>XÓA TÀI KHOẢN</h1>
    <h3>Bạn có chắc chắn muốn xóa tài khoản này không?</h3>

    <h4>Thông tin tài khoản</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.TenDangNhap)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TenDangNhap)
        </dd>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.MatKhau)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.MatKhau)
        </dd>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.VaiTro)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.VaiTro)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MaTaiKhoan" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
