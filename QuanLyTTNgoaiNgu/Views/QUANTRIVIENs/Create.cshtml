@model QuanLyTTNgoaiNgu.Models.QUANTRIVIEN

@{
    ViewData["Title"] = "Create";
}

<h1 class="page-title">Tạo Quản Trị Viên Mới</h1>

<div class="form-container">
    <div class="card custom-card">
        <div class="card-header custom-card-header">
            <h4 class="mb-0">Thông Tin Quản Trị Viên</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenQuanTriVien" class="form-label fw-bold"></label>
                    <input asp-for="TenQuanTriVien" class="form-control custom-input" />
                    <span asp-validation-for="TenQuanTriVien" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaTaiKhoan" class="form-label fw-bold"></label>
                    <select asp-for="MaTaiKhoan" class="form-select custom-input" asp-items="ViewBag.MaTaiKhoan"></select>
                </div>

                <div class="d-grid">
                    <input type="submit" value="Tạo" class="btn btn-danger btn-lg custom-btn" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3 text-center">
        <a asp-action="Index" class="custom-back-link">Quay lại danh sách</a>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: #fff5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .page-title {
            text-align: center;
            color: #c82333;
            margin-bottom: 30px;
            font-weight: 700;
            text-shadow: 1px 1px #f8d7da;
        }

        .form-container {
            display: flex;
            justify-content: center;
            margin-bottom: 50px;
        }

        .custom-card {
            width: 100%;
            max-width: 550px;
            border: 2px solid #c82333;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(200, 35, 51, 0.2);
        }

        .custom-card-header {
            background-color: #c82333;
            color: #fff;
            font-weight: 600;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .custom-input {
            border: 1.5px solid #c82333;
            border-radius: 8px;
            transition: all 0.3s;
        }

            .custom-input:focus {
                border-color: #a71d2a;
                box-shadow: 0 0 8px rgba(200, 35, 51, 0.3);
            }

        .custom-btn {
            background-color: #c82333;
            border: none;
            transition: all 0.3s;
        }

            .custom-btn:hover {
                background-color: #a71d2a;
                box-shadow: 0 4px 12px rgba(200, 35, 51, 0.4);
            }

        .custom-back-link {
            color: #c82333;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.3s;
        }

            .custom-back-link:hover {
                color: #a71d2a;
                text-decoration: underline;
            }
    </style>
}