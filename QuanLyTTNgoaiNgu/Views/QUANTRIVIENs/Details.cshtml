@model QuanLyTTNgoaiNgu.Models.QUANTRIVIEN

@{
    ViewData["Title"] = "Details";
}

<h1 class="page-title">Chi Tiết Quản Trị Viên</h1>

<div class="form-container">
    <div class="card custom-card">
        <div class="card-header custom-card-header">
            <h4 class="mb-0">Thông Tin Quản Trị Viên</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-4 fw-bold">Tên Quản Trị Viên:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.TenQuanTriVien)</dd>

                <dt class="col-sm-4 fw-bold">Tài Khoản:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.TaiKhoan.MatKhau)</dd>
            </dl>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.MaQuanTriVien" class="btn btn-danger btn-lg custom-btn">Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-outline-danger btn-lg custom-back-link">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: #fff5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .page-title {
            text-align: center;
            color: #c82333;
            margin-bottom: 30px;
            font-weight: 700;
            text-shadow: 1px 1px #f8d7da;
        }

        .form-container {
            display: flex;
            justify-content: center;
            margin-bottom: 50px;
        }

        .custom-card {
            width: 100%;
            max-width: 550px;
            border: 2px solid #c82333;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(200, 35, 51, 0.2);
        }

        .custom-card-header {
            background-color: #c82333;
            color: #fff;
            font-weight: 600;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        dl.row dt {
            font-weight: 600;
            color: #c82333;
        }

        .custom-btn {
            background-color: #c82333;
            border: none;
            flex: 1;
            transition: all 0.3s;
        }

            .custom-btn:hover {
                background-color: #a71d2a;
                box-shadow: 0 4px 12px rgba(200, 35, 51, 0.4);
            }

        .custom-back-link {
            flex: 1;
            text-align: center;
            color: #c82333;
            font-weight: 600;
            text-decoration: none;
            border: 2px solid #c82333;
            border-radius: 8px;
            padding: 0.45rem 0;
            transition: all 0.3s;
        }

            .custom-back-link:hover {
                background-color: #f8d7da;
                color: #a71d2a;
            }
    </style>
}