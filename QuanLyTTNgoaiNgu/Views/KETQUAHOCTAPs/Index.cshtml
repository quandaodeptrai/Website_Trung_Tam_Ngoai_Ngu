@model IEnumerable<QuanLyTTNgoaiNgu.Models.KETQUAHOCTAP>

@{
    ViewData["Title"] = "Kết quả học tập học viên";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h2 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #b30000;
            text-align: center;
            font-weight: 700;
        }

        .table-wrapper {
            max-width: 1000px;
            margin: 0 auto 40px;
            overflow-x: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204,0,0,0.2);
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
            text-align: center;
        }

        th {
            background-color: #cc0000;
            color: white;
            font-weight: 600;
        }

        tr:hover {
            background-color: #ffe6e6;
        }

        .action-buttons a {
            margin: 0 5px;
            padding: 8px 16px;
            font-size: 14px;
            border-radius: 8px;
            text-decoration: none;
            color: white;
            display: inline-block;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

        .btn-edit {
            background-color: #3a86ff;
        }

            .btn-edit:hover {
                background-color: #2b6ed3;
                transform: scale(1.05);
            }

        .btn-details {
            background-color: #43aa8b;
        }

            .btn-details:hover {
                background-color: #2f8f72;
                transform: scale(1.05);
            }

        .btn-excel {
            background-color: #28a745;
            color: white;
            padding: 10px 20px;
            font-size: 15px;
            font-weight: 500;
            border-radius: 8px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            .btn-excel:hover {
                background-color: #218838;
                transform: scale(1.05);
            }

        @@media (max-width: 768px) {
            .table-wrapper

        {
            padding: 15px;
        }

        th, td {
            padding: 8px;
            font-size: 14px;
        }

        .action-buttons a, .btn-excel {
            width: 100%;
            margin: 5px 0;
        }

        }
    </style>
}

<h2>@ViewData["Title"]</h2>

<div class="table-wrapper">
    <a asp-action="Export" class="btn-excel"><i class="fas fa-file-excel"></i> Xuất Excel</a>

    <table>
        <thead>
            <tr>
                <th>Mã Đăng ký</th>
                <th>Mã Học viên</th>
                <th>Họ tên Học viên</th>
                <th>Lớp học</th>
                <th>Điểm</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PHIEUDANGKY?.MaPhieu</td>
                    <td>@item.PHIEUDANGKY?.HOCVIEN?.MaHocVien</td>
                    <td>@item.PHIEUDANGKY?.HOCVIEN?.DANGKYMOI?.HoTen</td>
                    <td>@item.PHIEUDANGKY?.LOPHOC?.TenLopHoc</td>
                    <td>@item.Diem</td>
                    <td class="action-buttons">
                        <a asp-action="Details" asp-route-id="@item.MaKetQua" class="btn-details">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.MaKetQua" class="btn-edit">Sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>