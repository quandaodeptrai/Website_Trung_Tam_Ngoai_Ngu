@model QuanLyTTNgoaiNgu.Models.KETQUAHOCTAP

@{
    ViewData["Title"] = "Chi tiết kết quả học tập";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(to bottom, #ffe6e6, #fff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .details-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #fff;
            padding: 30px 35px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(204,0,0,0.2);
        }

        h2 {
            text-align: center;
            font-size: 28px;
            color: #b30000;
            margin-bottom: 25px;
            font-weight: 700;
        }

        dl {
            margin-top: 20px;
        }

        dt {
            font-weight: 600;
            color: #343a40;
            margin-top: 12px;
        }

        dd {
            margin-left: 0;
            margin-bottom: 10px;
            padding: 8px 12px;
            background-color: #ffe6e6;
            border-radius: 8px;
            color: #1d1d1d;
        }

        .btn-group {
            margin-top: 30px;
            text-align: center;
        }

        .btn {
            padding: 12px 22px;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            display: inline-block;
            min-width: 120px;
            transition: background-color 0.3s ease, transform 0.2s ease;
            color: white;
        }

        .btn-primary {
            background-color: #cc0000;
        }

            .btn-primary:hover {
                background-color: #990000;
                transform: scale(1.05);
            }

        .btn-secondary {
            background-color: #6c757d;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
                transform: scale(1.03);
            }

        @@media (max-width: 768px) {
            .btn

        {
            width: 100%;
            margin-bottom: 10px;
        }

        .details-container {
            padding: 25px 20px;
        }

        }
    </style>
}

<div class="details-container">
    <h2>@ViewData["Title"]</h2>

    <dl>
        <dt>Điểm</dt>
        <dd>@Html.DisplayFor(model => model.Diem)</dd>

        <dt>Mã phiếu đăng ký</dt>
        <dd>@Html.DisplayFor(model => model.PHIEUDANGKY.MaPhieu)</dd>
    </dl>

    <div class="btn-group">
        <a asp-action="Edit" asp-route-id="@Model?.MaKetQua" class="btn btn-primary">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>