@model QuanLyTTNgoaiNgu.Models.KETQUAHOCTAP

@{
    ViewData["Title"] = "Chi tiết kết quả học tập";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 26px;
            margin-bottom: 20px;
            color: #1d3557;
        }

        h4 {
            font-size: 20px;
            color: #457b9d;
            margin-bottom: 15px;
        }

        dl {
            background-color: #f1f1f1;
            padding: 20px;
            border-radius: 10px;
            max-width: 600px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        dt {
            font-weight: bold;
            color: #1d3557;
            margin-top: 10px;
        }

        dd {
            margin-left: 0;
            margin-bottom: 10px;
            color: #343a40;
        }

        .btn-group {
            margin-top: 25px;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: bold;
            text-decoration: none;
            transition: background-color 0.3s ease;
            margin-right: 10px;
        }

        .btn-primary {
            background-color: #3a86ff;
            color: white;
            border: none;
        }

            .btn-primary:hover {
                background-color: #2b6ed3;
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
            }
    </style>
}

<h1>@ViewData["Title"]</h1>

<h4>Thông tin kết quả học tập</h4>
<hr />

<dl>
    <dt>Điểm</dt>
    <dd>@Html.DisplayFor(model => model.Diem)</dd>

    <dt>Mã phiếu đăng ký</dt>
    <dd>@Html.DisplayFor(model => model.PHIEUDANGKY.MaPhieu)</dd>
</dl>

<div class="btn-group">
    <a asp-action="Edit" asp-route-id="@Model?.MaKetQua" class="btn btn-primary">Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>
