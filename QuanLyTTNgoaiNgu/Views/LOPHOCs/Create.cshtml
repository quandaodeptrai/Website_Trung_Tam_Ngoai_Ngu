@model QuanLyTTNgoaiNgu.Models.LOPHOC
@{
    ViewData["Title"] = "Tạo lớp học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        h2 {
            font-size: 28px;
            margin-bottom: 25px;
            color: #c1121f;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        h2 i {
            color: #c1121f;
            font-size: 30px;
        }

        form {
            background: #fff;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 10px 25px rgba(193, 18, 31, 0.15);
            max-width: 750px;
            border-top: 5px solid #c1121f;
            animation: fadeIn 0.3s ease-in-out;
        }

       @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .mb-3 label {
            font-weight: 600;
            color: #c1121f;
            margin-bottom: 6px;
        }

        input.form-control,
        select.form-select {
            font-size: 16px;
            border-radius: 10px;
            border: 1.5px solid #e0e0e0;
            padding: 10px 12px;
            transition: 0.25s ease;
        }

        input.form-control:focus,
        select.form-select:focus {
            border-color: #c1121f;
            box-shadow: 0 0 8px rgba(193, 18, 31, 0.3);
        }

        .btn-success {
            background-color: #c1121f;
            border: none;
            padding: 10px 22px;
            border-radius: 10px;
            font-weight: bold;
            transition: 0.2s;
        }

        .btn-success i {
            margin-right: 6px;
        }

        .btn-success:hover {
            background-color: #a20d19;
        }

        .btn-secondary {
            background-color: #6c757d;
            border-radius: 10px;
        }

        .btn-secondary:hover {
            background-color: #555;
        }

        /* icon trong label */
        .lbl-icon {
            margin-right: 6px;
            color: #c1121f;
        }
    </style>
}

<h2><i class="fa-solid fa-chalkboard"></i> @ViewData["Title"]</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="TenLopHoc" class="form-label"><i class="fa-solid fa-school lbl-icon"></i> Tên lớp học
        </label>
        <input asp-for="TenLopHoc" class="form-control" />
        <span asp-validation-for="TenLopHoc" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SLHocVienToiDa" class="form-label">
            <i class="fa-solid fa-users lbl-icon"></i> Số lượng học viên tối đa
        </label>
        <input asp-for="SLHocVienToiDa" type="number" class="form-control" />
        <span asp-validation-for="SLHocVienToiDa" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NgayBatDau" class="form-label">
            <i class="fa-solid fa-calendar-day lbl-icon"></i> Ngày bắt đầu
        </label>
        <input asp-for="NgayBatDau" id="NgayBatDau" type="date" class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="NgayBatDau" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NgayKetThuc" class="form-label">
            <i class="fa-solid fa-calendar-check lbl-icon"></i> Ngày kết thúc
        </label>
        <input asp-for="NgayKetThuc" id="NgayKetThuc" type="date" class="form-control"
               min="@((Model?.NgayBatDau ?? DateTime.Now).AddDays(1).ToString("yyyy-MM-dd"))" />
        <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaKhoaHoc" class="form-label">
            <i class="fa-solid fa-book lbl-icon"></i> Khóa học
        </label>
        <select asp-for="MaKhoaHoc" class="form-select" asp-items="ViewBag.MaKhoaHoc">
            <option value="">-- Chọn khóa học --</option>
        </select>
        <span asp-validation-for="MaKhoaHoc" class="text-danger"></span>
    </div>

    <input asp-for="MaGiangVien" type="hidden" value="1" />

    <button type="submit" class="btn btn-success">
        <i class="fa-solid fa-plus-circle"></i> Tạo mới
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">
        <i class="fa-solid fa-xmark"></i> Hủy
    </a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        (function () {
            const start = document.getElementById('NgayBatDau');
            const end = document.getElementById('NgayKetThuc');

            const pad = n => n.toString().padStart(2, '0');
            function isoDate(d) {
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
            }

            const today = new Date();
            start.min = isoDate(today);

            function updateEndMin() {
                let base = start.value ? new Date(start.value) : new Date();
                base.setDate(base.getDate() + 1);
                const minStr = isoDate(base);
                end.min = minStr;

                if (end.value) {const cur = new Date(end.value);
                    if (cur <= new Date(minStr)) {
                        end.value = '';
                    }
                }
            }

            updateEndMin();
            start.addEventListener('change', updateEndMin);
        })();
    </script>
}