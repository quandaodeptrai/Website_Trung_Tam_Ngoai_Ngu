@model QuanLyTTNgoaiNgu.Models.LOPHOC

@{
    ViewData["Title"] = "Chi tiết lớp học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            color: #1d3557;
            margin-bottom: 25px;
        }

        .details-box {
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.05);
            max-width: 800px;
        }

        dt {
            font-weight: bold;
            color: #0d3b66;
        }

        dd {
            margin-bottom: 16px;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.3s ease;
            margin-right: 10px;
        }

        .btn-edit {
            background-color: #3a86ff;
            color: white;
        }

            .btn-edit:hover {
                background-color: #2b6ed3;
            }

        .btn-back {
            background-color: #6c757d;
            color: white;
        }

            .btn-back:hover {
                background-color: #5a6268;
            }
    </style>
}

<h1>@ViewData["Title"]</h1>

<div class="details-box">
    <dl class="row">
        <dt class="col-sm-3">Tên lớp học</dt>
        <dd class="col-sm-9">@Model.TenLopHoc</dd>

        <dt class="col-sm-3">Số lượng tối đa</dt>
        <dd class="col-sm-9">@Model.SLHocVienToiDa</dd>

        <dt class="col-sm-3">Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Ngày kết thúc</dt>
        <dd class="col-sm-9">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Khóa học</dt>
        <dd class="col-sm-9">@Model.KHOAHOC?.TenKhoaHoc</dd>

        <dt class="col-sm-3">Giảng viên</dt>
        <dd class="col-sm-9">@Model.GIANGVIEN?.HoTen</dd>
    </dl>

    <div>
        <a asp-action="Edit" asp-route-id="@Model.MaLopHoc" class="btn btn-edit">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-back">Quay lại danh sách</a>
    </div>
</div>
