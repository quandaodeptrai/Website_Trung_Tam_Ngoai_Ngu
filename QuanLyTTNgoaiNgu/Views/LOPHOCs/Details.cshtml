@model QuanLyTTNgoaiNgu.Models.LOPHOC

@{
    ViewData["Title"] = "Chi tiết lớp học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        .page-title {
            font-size: 32px;
            font-weight: 800;
            color: #b60000;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

            .page-title i {
                color: #ff0000;
            }

        .details-box {
            background: #ffffff;
            border: 1px solid #ffd6d6;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 8px 18px rgba(255, 0, 0, 0.1);
            max-width: 850px;
            animation: fadeIn 0.4s ease;
        }

        dt {
            font-weight: 700;
            color: #9c0000;
        }

        dd {
            margin-bottom: 18px;
            color: #333;
        }

        .btn {
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 700;
            transition: 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-edit {
            background: linear-gradient(45deg, #ff3b3b, #b30000);
            color: white;
            box-shadow: 0 4px 12px rgba(255, 0, 0, 0.25);
        }

            .btn-edit:hover {
                background: linear-gradient(45deg, #cc0000, #8b0000);
            }

        .btn-back {
            background: #6c757d;
            color: white;
        }

            .btn-back:hover {
                background: #5a6268;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

<h1 class="page-title">
    <i class="fa-solid fa-circle-info"></i> @ViewData["Title"]
</h1>

<div class="details-box">
    <dl class="row">
        <dt class="col-sm-3"><i class="fa-solid fa-chalkboard"></i> Tên lớp học</dt>
        <dd class="col-sm-9">@Model.TenLopHoc</dd>

        <dt class="col-sm-3"><i class="fa-solid fa-users"></i> Số lượng tối đa</dt>
        <dd class="col-sm-9">@Model.SLHocVienToiDa</dd>

        <dt class="col-sm-3"><i class="fa-solid fa-calendar-days"></i> Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3"><i class="fa-solid fa-calendar-check"></i> Ngày kết thúc</dt>
        <dd class="col-sm-9">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3"><i class="fa-solid fa-graduation-cap"></i> Khóa học</dt>
        <dd class="col-sm-9">@Model.KHOAHOC?.TenKhoaHoc</dd>
        <dt class="col-sm-3"><i class="fa-solid fa-person-chalkboard"></i> Giảng viên</dt>
        <dd class="col-sm-9">@Model.GIANGVIEN?.HoTen</dd>
    </dl>

    <div>
        <a asp-action="Edit" asp-route-id="@Model.MaLopHoc" class="btn btn-edit">
            <i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa
        </a>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>