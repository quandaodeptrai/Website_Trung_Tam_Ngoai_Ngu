@model IEnumerable<QuanLyTTNgoaiNgu.Models.LOPHOC>

@{
    ViewData["Title"] = "Quản lý Lớp học";
    Layout = "_LayoutAdmin";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        h2 {
            font-size: 28px;
            margin-bottom: 25px;
            font-weight: 700;
            color: #b60000;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 14px rgba(255, 0, 0, 0.15);
        }

        th {
            background: #d00000;
            color: white;
            font-weight: 600;
            padding: 13px 16px;
            text-transform: uppercase;
        }

        td {
            padding: 13px 16px;
            border-bottom: 1px solid #ffe0e0;
        }

        tr:hover {
            background: #fff5f5;
        }

        /* Action buttons */
        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .btn-action {
            border-radius: 8px;
            padding: 7px 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            font-size: 14px;
            color: white;
            transition: 0.2s;
            font-weight: 600;
        }

        /* Chi tiết */
        .btn-details {
            background: #e53935;
        }

            .btn-details:hover {
                background: #c62828;
            }

        /* Sửa */
        .btn-edit {
            background: #ffb300;
            color: #5d4300;
        }

            .btn-edit:hover {
                background: #e5a000;
            }

        /* Xóa */
        .btn-delete {
            background: #c70000;
        }

            .btn-delete:hover {
                background: #9b0000;
            }

        /* Nút tạo lớp mới */
        .btn-create {
            padding: 12px 20px;
            background: #d00000;
            color: white;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(255, 0, 0, 0.2);
            transition: .25s;
        }

            .btn-create:hover {
                background: #a80000;
            }
        /* Filter box */
        .filter-box {
            background: white;
            padding: 18px 20px;
            border-radius: 12px;
            box-shadow: 0 5px 14px rgba(255, 0, 0, 0.12);
            margin-bottom: 22px;
        }

        .filter-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-input {
            padding: 10px 14px;
            border: 1px solid #ffd4d4;
            border-radius: 8px;
            font-size: 14px;
            min-width: 180px;
        }

            .filter-input:focus {
                outline: none;
                border-color: #d00000;
                box-shadow: 0 0 4px rgba(208, 0, 0, 0.4);
            }

        /* Filter button */
        .btn-filter {
            padding: 10px 18px;
            background: #d00000;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: .2s;
        }

            .btn-filter:hover {
                background: #a80000;
            }

    </style>
}

<h2><i class="fa-solid fa-school-flag"></i> @ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn-create">
        <i class="fa-solid fa-plus"></i> Tạo lớp mới
    </a>
</p>
<form method="get" class="filter-box">
    <div class="filter-row">
        <input type="text" name="tenLop"
               value="@Context.Request.Query["tenLop"]"
               placeholder="Tên lớp..." class="filter-input" />

        <input type="date" name="ngayBD"
               value="@Context.Request.Query["ngayBD"]"
               class="filter-input" />

        <input type="date" name="ngayKT"
               value="@Context.Request.Query["ngayKT"]"
               class="filter-input" />

        <select name="giangVien" class="filter-input">
            <option value="">-- Giảng viên --</option>

            @foreach (var gv in ViewBag.GiangVienList)
            {
                <option value="@gv.MaGiangVien"
        @@(Context.Request.Query["giangVien"] == gv.MaGiangVien.ToString() ? "selected" : "")>
    @gv.HoTen
</option>

            }
        </select>

        <button type="submit" class="btn-filter">
            <i class="fa-solid fa-filter"></i> Lọc
        </button>
    </div>
</form>


<table>
    <thead>
        <tr>
            <th>Mã lớp</th>
            <th>Tên lớp</th>
            <th>SL tối đa</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Khóa học</th>
            <th>Giảng viên</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.MaLopHoc</td>
                <td>@l.TenLopHoc</td>
                <td>@l.SLHocVienToiDa</td>
                <td>@l.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@l.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@l.KHOAHOC?.TenKhoaHoc</td>
                <td>@l.GIANGVIEN?.HoTen</td>

                <td>
                    <div class="action-buttons">

                        <a asp-action="Details" asp-route-id="@l.MaLopHoc"
                           class="btn-action btn-details">
                            <i class="fa-solid fa-eye"></i> Chi tiết
                        </a>

                        <a asp-action="Edit" asp-route-id="@l.MaLopHoc"
                           class="btn-action btn-edit">
                            <i class="fa-solid fa-pen-to-square"></i> Sửa
                        </a>

                        <a asp-action="Delete" asp-route-id="@l.MaLopHoc"
                           class="btn-action btn-delete">
                            <i class="fa-solid fa-trash"></i> Xóa
                        </a>

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>