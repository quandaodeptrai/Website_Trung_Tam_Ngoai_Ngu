@model IEnumerable<QuanLyTTNgoaiNgu.Models.LOPHOC>
@{
    ViewData["Title"] = "Quản lý Lớp học";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" asp-controller="LOPHOCs" class="btn btn-primary">Tạo lớp mới</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã lớp</th><th>Tên lớp</th><th>SL tối đa</th>
            <th>Ngày bắt đầu</th><th>Ngày kết thúc</th>
            <th>Khóa học</th><th>Giảng viên</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.MaLopHoc</td>
                <td>@l.TenLopHoc</td>
                <td>@l.SLHocVienToiDa</td>
                <td>@l.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@l.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@l.KHOAHOC?.TenKhoaHoc</td>
                <td>@l.GIANGVIEN?.HoTen</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@l.MaLopHoc" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Details" asp-route-id="@l.MaLopHoc" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@l.MaLopHoc" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
