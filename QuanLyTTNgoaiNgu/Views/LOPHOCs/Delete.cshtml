@model QuanLyTTNgoaiNgu.Models.LOPHOC

@{
    ViewData["Title"] = "Xóa lớp học";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <style>
        h1 {
            font-size: 28px;
            color: #d90429;
            margin-bottom: 10px;
        }

        h3 {
            color: #6c757d;
            margin-bottom: 20px;
        }

        .confirm-box {
            background-color: #fff3f3;
            border: 1px solid #e63946;
            padding: 25px 30px;
            border-radius: 12px;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
            max-width: 800px;
        }

        dt {
            font-weight: 600;
            color: #1d3557;
        }

        dd {
            margin-bottom: 16px;
        }

        .form-actions {
            margin-top: 30px;
        }

        .btn-danger {
            background-color: #e63946;
            border: none;
            color: white;
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 6px;
        }

            .btn-danger:hover {
                background-color: #c82333;
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 6px;
            margin-left: 10px;
            text-decoration: none;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
            }
    </style>
}

<h1>@ViewData["Title"]</h1>
<h3>Bạn có chắc chắn muốn xóa lớp học này không?</h3>

<div class="confirm-box">
    <dl class="row">
        <dt class="col-sm-3">Tên lớp học</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.TenLopHoc)</dd>

        <dt class="col-sm-3">Số lượng tối đa</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.SLHocVienToiDa)</dd>

        <dt class="col-sm-3">Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Ngày kết thúc</dt>
        <dd class="col-sm-9">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Khóa học</dt>
        <dd class="col-sm-9">@Model.KHOAHOC?.TenKhoaHoc</dd>

        <dt class="col-sm-3">Giảng viên</dt>
        <dd class="col-sm-9">@Model.GIANGVIEN?.HoTen</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaLopHoc" />
        <div class="form-actions">
            <input type="submit" value="Xóa" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div>
